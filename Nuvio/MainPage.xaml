<Page
    x:Class="Nuvio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:shared="using:Nuvio.Views.Shared"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    Background="Black">

    <Page.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Padding="{TemplateBinding Padding}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="Black"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <!-- Native Windows Media Foundation surface; controls are drawn by the native UI above it. -->
        <MediaPlayerElement x:Name="MediaElement" x:Load="False" SizeChanged="MediaElement_SizeChanged"
                            Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                            FlowDirection="LeftToRight" AreTransportControlsEnabled="False" Stretch="Uniform" />

        <!-- LibVLC fallback surface, used only when WMF cannot play a source. -->
        <vlc:VideoView x:Name="VideoView" x:Load="False"
                       SizeChanged="VideoView_SizeChanged" Opacity="0"
                       IsHitTestVisible="False" IsTabStop="False" />

        <!-- WebView2 is kept collapsed and never navigated in the native UI (M8 legacy import). -->
        <controls:WebView2 x:Name="WebView" FlowDirection="LeftToRight" Visibility="Collapsed" />

        <Grid x:Name="ShellGrid" Background="#FF0D0E13">
            <Grid.ColumnDefinitions>
                <!-- Column 0 is the flow-start edge (right in RTL, left in LTR): the
                     sidebar docks there by column, not by a one-time HorizontalAlignment
                     set in the constructor. Build 162 proved the constructor value can
                     disagree with the rendered direction (strip on the left while the
                     rows render RTL); the column follows the page's flow direction, so
                     the strip can no longer land on the wrong edge. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Content fills the shell; the sidebar is an overlay on top of it (web:
                 position absolute, z-index 20), so expanding it never moves the content. -->
            <Frame x:Name="ContentFrame" Grid.Column="0" Grid.ColumnSpan="2" Navigated="ContentFrame_Navigated" NavigationFailed="ContentFrame_NavigationFailed"/>

            <!-- Collapsing sidebar: icons only (48 epx), expands to 136 epx when a sidebar button is focused or the pointer hovers (web: 6rem to 17rem, width .22s). -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="48" Background="#FF111218" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
                <!-- Logo on top (web: .sidebar-logo, 2.8rem icon, 3rem below it) and the
                     nav buttons vertically centered in the strip (web: .sidebar-items
                     flex 1, justify-content center, margin-top -6rem). The logo icon sits
                     at the same start offset as the button icons (8 epx panel + 8 epx
                     button padding); the NUVIO wordmark fades in with the labels on
                     expand, so the strip shows the icon alone when collapsed. -->
                <Grid Margin="8,19,8,19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="8,0" Margin="0,0,0,24">
                        <!-- The wordmark already contains the triangle, so the icon and the
                             wordmark share one cell and cross-fade (AnimateSidebar): collapsed
                             shows the icon alone, expanded shows the full lockup once — never
                             triangle + nuvio + triangle as in build 162. -->
                        <Image x:Name="SidebarLogoIcon" Source="ms-appx:///web/assets/icon.png" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Image x:Name="SidebarLogoWordmark" Source="ms-appx:///web/assets/wordmark.png" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                    </Grid>
                    <StackPanel x:Name="SidebarItemsPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,-48,0,0" Spacing="5">
                    <Button x:Name="HomeButton" Style="{StaticResource SidebarButtonStyle}" Tag="home" Click="SidebarButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE80F;" FontSize="14"/>
                            <TextBlock x:Name="HomeLabel" x:Uid="SidebarHomeLabel" Text="Home" FontSize="10" VerticalAlignment="Center" Opacity="0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SearchButton" Style="{StaticResource SidebarButtonStyle}" Tag="search" Click="SidebarButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE721;" FontSize="14"/>
                            <TextBlock x:Name="SearchLabel" x:Uid="SidebarSearchLabel" Text="Search" FontSize="10" VerticalAlignment="Center" Opacity="0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryButton" Style="{StaticResource SidebarButtonStyle}" Tag="library" Click="SidebarButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                            <TextBlock x:Name="LibraryLabel" x:Uid="SidebarLibraryLabel" Text="Library" FontSize="10" VerticalAlignment="Center" Opacity="0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButtonStyle}" Tag="settings" Click="SidebarButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="14"/>
                            <TextBlock x:Name="SettingsLabel" x:Uid="SidebarSettingsLabel" Text="Settings" FontSize="10" VerticalAlignment="Center" Opacity="0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProfileButton" Style="{StaticResource SidebarButtonStyle}" Tag="profile" Visibility="Collapsed" Click="SidebarButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="14"/>
                            <TextBlock x:Name="ProfileLabel" x:Uid="SidebarSwitchProfileLabel" Text="Switch profile" FontSize="10" VerticalAlignment="Center" Opacity="0"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <Grid x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" IsHitTestVisible="False">
            <shared:ToastControl x:Name="Toast"/>
        </Grid>

        <Grid x:Name="LoadErrorPanel" Background="#FF0D0E13" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Padding="24" Spacing="16">
                <TextBlock x:Name="LoadErrorTitle" Text="Couldn't load Nuvio" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadErrorText" Foreground="#B3FFFFFF" TextWrapping="Wrap" TextAlignment="Left" FlowDirection="LeftToRight" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button x:Name="RetryButton" Content="Retry" MinWidth="160" />
                    <Button x:Name="BuiltInButton" Content="Use the built-in app" MinWidth="160" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
