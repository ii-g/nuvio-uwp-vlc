<Page
    x:Class="Nuvio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:shared="using:Nuvio.Views.Shared"
    xmlns:views="using:Nuvio.Views"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    Background="Black">

    <Page.Resources>
        <!-- Flow converters shared with the home page (classes in HomePage.xaml.cs): the
             sidebar divider, logo alignment and logo padding are bound to each element's
             own FlowDirection so they track RTL without a code-behind set (build 180
             showed those sets not reaching the render while the log proved RTL). -->
        <views:FlowDirectionToThicknessConverter x:Key="FlowDirectionToThicknessConverter"/>
        <views:FlowDirectionToHorizontalAlignmentConverter x:Key="FlowDirectionToHorizontalAlignmentConverter"/>
        <views:FlowDirectionToTextAlignmentConverter x:Key="FlowDirectionToTextAlignmentConverter"/>
        <!-- Focus frame: a single plain solid white ring, 3 epx, Opacity 0
             until Focused/PointerFocused (PointerOver on cards). No
             gradient, no shine, no animation on the ring itself. The
             1.06 focus zoom is untouched. -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- State background (active / hover / pressed) on its
                                 own Border so it can hide while the strip is collapsed: its
                                 Visibility follows SidebarLogoWordmark's, which AnimateSidebar
                                 pins to Collapsed the moment a collapse starts and to Visible
                                 the moment an expansion starts — so in the collapsed strip the
                                 active page shows only the ActiveUnderline under the icon (no
                                 circle: on the 32 epx-wide strip the pill would render as one),
                                 and the pill background is back as soon as the strip opens.
                                 ElementName resolves through the templated parent's namescope
                                 (the page), where the wordmark lives. -->
                            <Border x:Name="StateBackground" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Visibility="{Binding Visibility, ElementName=SidebarLogoWordmark}"/>
                            <!-- The content is a Grid that fills the button (see the five buttons
                                 below): its first column is the icon at the flow-start edge and
                                 the label column stretches, with the label text aligned to the
                                 flow-start edge by the text-alignment converter — so the labels'
                                 start edges line up with the icon column and the far edges vary,
                                 as in the web sidebar. The presenter is stretched on purpose:
                                 a TemplateBinding (build 180) and a live TemplatedParent binding
                                 to HorizontalContentAlignment (build 185) both left the content
                                 hugging the wrong edge in the build 216 photos — labels
                                 left-aligned, icons floating after each label — so no binding
                                 owns this alignment any more. SetFlowDirection no longer sets
                                 HorizontalContentAlignment; the Grid columns do the work. -->
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="{TemplateBinding Padding}"/>
                            <!-- Active-item underline: a thin light transparent line under
                                 the icon (2 epx, #33FFFFFF), 6 epx in from the flow-start
                                 edge and 3 epx up from the button's bottom edge.
                                 SetSidebarActive shows it for the current page only. The
                                 blue accent bar is gone on purpose: on the frosted strip
                                 it read as a stray blue tick on the button's edge. -->
                            <Border x:Name="ActiveUnderline" Width="18" Height="2" CornerRadius="1" Background="#33FFFFFF" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}}" VerticalAlignment="Bottom" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=activeUnderline}" Visibility="Collapsed"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <!-- Button states, matched to the web sidebar (web/css/app.css):
                                     default = transparent bg, muted text/icon (the style's
                                     Foreground setter); hover = surface-2 bg + white text
                                     (web .sidebar-item:hover); pressed = surface-3 bg + white
                                     text; focused = plain white frame + white text, no fill. The web's
                                     focused white inversion (.sidebar-item.focused: background
                                     #fff, color #000) is deliberately NOT ported: on the frosted
                                     strip it read as a bright pill with a white ring that clashed
                                     with the dark theme, in every state — focused, pressed and
                                     merely selected — so the states stay in the dark theme; hover and pressed differ only in surface depth, and focus adds the plain white frame. The active (selected-page)
                                     look is owned by SetSidebarActive: surface-2 bg + white
                                     text + the underline below (a thin light transparent line
                                     under the icon, replacing the blue accent bar). Collapsed,
                                     the state background hides entirely (StateBackground follows
                                     the wordmark's Visibility): on the 32 epx-wide strip the pill
                                     would read as a circle behind the icon, so the active page
                                     shows only the underline there. -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <!-- The 130 ms state cross-fade and the 0.96 press shrink from
                                         build 241 are removed: that animation is not what Mohammed
                                         meant by button animation. The icon itself moves on focus
                                         arrival instead (MainPage.xaml.cs PlaySidebarIconAnimation),
                                         while state changes snap as before build 241. -->
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StateBackground" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#29FFFFFF"/></ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <!-- Native Windows Media Foundation surface; controls are drawn by the native UI above it. -->
        <MediaPlayerElement x:Name="MediaElement" x:Load="False" SizeChanged="MediaElement_SizeChanged"
                            Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                            FlowDirection="LeftToRight" AreTransportControlsEnabled="False" Stretch="Uniform" />

        <!-- LibVLC fallback surface, used only when WMF cannot play a source. -->
        <vlc:VideoView x:Name="VideoView" x:Load="False"
                       SizeChanged="VideoView_SizeChanged" Opacity="0"
                       IsHitTestVisible="False" IsTabStop="False" />

        <!-- WebView2 is kept collapsed and never navigated in the native UI (M8 legacy import). -->
        <controls:WebView2 x:Name="WebView" FlowDirection="LeftToRight" Visibility="Collapsed" />

        <Grid x:Name="ShellGrid" Background="#FF0D0E13">
            <Grid.ColumnDefinitions>
                <!-- Column 0 is the flow-start edge (right in RTL, left in LTR): the
                     sidebar docks there by column, not by a one-time HorizontalAlignment
                     set in the constructor. Build 162 proved the constructor value can
                     disagree with the rendered direction (strip on the left while the
                     rows render RTL); the column follows the page's flow direction, so
                     the strip can no longer land on the wrong edge. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Content fills the shell; the sidebar is an overlay on top of it (web:
                 position absolute, z-index 20), so expanding it never moves the content. -->
            <Frame x:Name="ContentFrame" Grid.Column="0" Grid.ColumnSpan="2" Navigated="ContentFrame_Navigated" NavigationFailed="ContentFrame_NavigationFailed"/>

            <!-- Collapsing sidebar: icons only (48 epx), expands to 136 epx when a sidebar button is focused or the pointer hovers (web: 6rem to 17rem, width .22s).
                 The divider is bound to the border's own FlowDirection ("divider"): it sits
                 on the content-facing edge (left in RTL), never on the outer edge against
                 the screen — build 180 showed a line and a gap on the outer edge.
                 Frosted glass: a custom Composition backdrop blur
                 (SidebarBackdropBlurBrush) — GaussianBlur 20 over the home backdrop
                 and rows behind the strip, with a 25% black tint overlay
                 (Rectangle) on top of the blur, below the menu content.
                 Chosen over AcrylicBrush by Mohammed's call: full control of the
                 blur amount and tint, and a documented Xbox-compatible path
                 (HostBackdrop acrylic would render only the fallback on Xbox).
                 If the blur cannot be built, the brush falls back to the old
                 solid #111218 and logs, so the sidebar never breaks startup. -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="48" BorderBrush="#14FFFFFF" BorderThickness="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=divider}">
                <Border.Background>
                    <shared:SidebarBackdropBlurBrush/>
                </Border.Background>
                <!-- Logo on top (web: .sidebar-logo, 2.8rem icon, 3rem below it) and the
                     nav buttons vertically centered in the strip (web: .sidebar-items
                     flex 1, justify-content center, margin-top -6rem). The logo icon sits
                     at the same start offset as the button icons (8 epx panel + 8 epx
                     button padding); the NUVIO wordmark fades in with the labels on
                     expand, so the strip shows the icon alone when collapsed. -->
                <Grid>
                    <!-- Dark tint over the frosted blur (25% black),
                         below the menu content. -->
                    <Rectangle Fill="#40000000"/>
                    <Grid Margin="8,19,8,19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,24" FlowDirection="LeftToRight">
                        <!-- The collapsed icon is the official NuvioTV brand mark
                             (NuvioTV repo, assets/brand/app_logo_mark.png,
                             1080x1080, commit 17ddebe): the gradient play
                             triangle with its dark inner triangle and white
                             play glyph, traced to XAML Paths from the PNG
                             contours (radial ray-cast + Douglas-Peucker,
                             max 3 px deviation at 1080 scale, about 0.12 px
                             at 22 epx; shape verified against the source
                             image side by side). The mark PNG itself is a
                             full opaque square on dark navy #0D101E and
                             cannot be uploaded as a binary through the
                             Contents API, so only the triangle is drawn as
                             vectors (no dark tile) and the wordmark file is
                             untouched. The fork's wordmark.png is
                             byte-identical to NuvioTV's wordmark, so the
                             expanded state (triangle + nuvio) already is
                             the official wordmark. The gradient is a 4-stop
                             diagonal approximation of the mark's cyan to
                             blue to purple flow (#4ADEEF, #1973C5, #6753DF,
                             #B64DF5). AnimateSidebar still cross-fades this
                             Grid with the wordmark, and the wordmark is
                             still hidden the moment a collapse starts. -->
                        <Grid x:Name="SidebarLogoIcon" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,22,22"/>
                            </Grid.Clip>
                            <Path Data="M 21.01,11.02 L 20.56,12.83 L 20.07,13.53 L 19.20,14.23 L 6.46,21.63 L 5.22,22.00 L 3.50,21.79 L 2.55,21.30 L 1.73,20.52 L 1.03,18.92 L 0.99,3.37 L 1.27,2.26 L 2.18,0.99 L 3.58,0.16 L 5.18,0.00 L 6.25,0.29 L 19.49,7.98 L 20.52,9.09 L 20.89,9.99 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF4ADEEF"/>
                                        <GradientStop Offset="0.35" Color="#FF1973C5"/>
                                        <GradientStop Offset="0.7" Color="#FF6753DF"/>
                                        <GradientStop Offset="1" Color="#FFB64DF5"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M 14.60,11.02 L 14.39,11.80 L 13.94,12.25 L 8.02,15.67 L 6.79,15.71 L 6.17,15.21 L 5.88,14.52 L 5.88,7.48 L 6.04,6.99 L 6.79,6.29 L 8.02,6.33 L 13.94,9.75 L 14.39,10.20 Z" Fill="#FF0D101E"/>
                            <Path Data="M 11.56,11.02 L 11.47,11.31 L 10.86,11.76 L 8.92,12.87 L 8.35,12.87 L 8.06,12.54 L 8.06,9.46 L 8.35,9.13 L 8.92,9.13 L 11.27,10.49 L 11.47,10.69 Z" Fill="White"/>
                        </Grid>
                        <Image x:Name="SidebarLogoWordmark" Source="ms-appx:///web/assets/wordmark.png" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel x:Name="SidebarItemsPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,-48,0,0" Spacing="5">
                    <Button x:Name="HomeButton" Style="{StaticResource SidebarButtonStyle}" Tag="home" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon/label glow: soft omnidirectional halo via
                                 shared:TextGlow (Composition DropShadow, blur 3,
                                 black 90%) so the white icons and labels read on
                                 light fanart behind the frosted strip. The glow
                                 lives on each icon/label's own visual, so it
                                 follows the label's collapse fade and the icon
                                 jiggle transform. -->
                            <FontIcon Glyph="&#xE80F;" FontSize="14" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"><FontIcon.RenderTransform><CompositeTransform x:Name="HomeIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="HomeLabel" x:Uid="SidebarHomeLabel" Text="Home" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SearchButton" Style="{StaticResource SidebarButtonStyle}" Tag="search" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="14" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"><FontIcon.RenderTransform><CompositeTransform x:Name="SearchIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="SearchLabel" x:Uid="SidebarSearchLabel" Text="Search" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                    </Button>
                    <Button x:Name="LibraryButton" Style="{StaticResource SidebarButtonStyle}" Tag="library" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontSize="14" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"><FontIcon.RenderTransform><CompositeTransform x:Name="LibraryIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="LibraryLabel" x:Uid="SidebarLibraryLabel" Text="Library" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButtonStyle}" Tag="settings" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="14" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"><FontIcon.RenderTransform><CompositeTransform x:Name="SettingsIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="SettingsLabel" x:Uid="SidebarSettingsLabel" Text="Settings" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ProfileButton" Style="{StaticResource SidebarButtonStyle}" Tag="profile" Visibility="Collapsed" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"><FontIcon.RenderTransform><CompositeTransform x:Name="ProfileIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="ProfileLabel" x:Uid="SidebarSwitchProfileLabel" Text="Switch profile" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                    </Button>
                    </StackPanel>
                </Grid>
                </Grid>
            </Border>

            <!-- AnimatedFocusBorder PoC host: one shared beam visual lives here,
                 above the content and the sidebar, below the toasts. It never
                 receives input. -->
            <Canvas x:Name="FocusBeamHost" Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="False" />

        </Grid>

        <Grid x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" IsHitTestVisible="False">
            <shared:ToastControl x:Name="Toast"/>
        </Grid>

        <Grid x:Name="LoadErrorPanel" Background="#FF0D0E13" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Padding="24" Spacing="16">
                <TextBlock x:Name="LoadErrorTitle" Text="Couldn't load Nuvio" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadErrorText" Foreground="#B3FFFFFF" TextWrapping="Wrap" TextAlignment="Left" FlowDirection="LeftToRight" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button x:Name="RetryButton" Content="Retry" MinWidth="160" />
                    <Button x:Name="BuiltInButton" Content="Use the built-in app" MinWidth="160" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
