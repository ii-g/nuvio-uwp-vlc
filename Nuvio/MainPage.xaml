<Page
    x:Class="Nuvio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:shared="using:Nuvio.Views.Shared"
    xmlns:views="using:Nuvio.Views"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    FlowDirection="RightToLeft"
    Background="Black">

    <Page.Resources>
        <!-- Flow converters shared with the home page (classes in HomePage.xaml.cs): the
             sidebar divider, logo alignment and logo padding are bound to each element's
             own FlowDirection so they track RTL without a code-behind set (build 180
             showed those sets not reaching the render while the log proved RTL). -->
        <views:FlowDirectionToThicknessConverter x:Key="FlowDirectionToThicknessConverter"/>
        <views:FlowDirectionToHorizontalAlignmentConverter x:Key="FlowDirectionToHorizontalAlignmentConverter"/>
        <views:FlowDirectionToTextAlignmentConverter x:Key="FlowDirectionToTextAlignmentConverter"/>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- The content is a Grid that fills the button (see the five buttons
                                 below): its first column is the icon at the flow-start edge and
                                 the label column stretches, with the label text aligned to the
                                 flow-start edge by the text-alignment converter — so the labels'
                                 start edges line up with the icon column and the far edges vary,
                                 as in the web sidebar. The presenter is stretched on purpose:
                                 a TemplateBinding (build 180) and a live TemplatedParent binding
                                 to HorizontalContentAlignment (build 185) both left the content
                                 hugging the wrong edge in the build 216 photos — labels
                                 left-aligned, icons floating after each label — so no binding
                                 owns this alignment any more. SetFlowDirection no longer sets
                                 HorizontalContentAlignment; the Grid columns do the work. -->
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="{TemplateBinding Padding}"/>
                            <!-- Active-item underline: a thin light transparent line under
                                 the icon (2 epx, #33FFFFFF), 6 epx in from the flow-start
                                 edge and 3 epx up from the button's bottom edge.
                                 SetSidebarActive shows it for the current page only. The
                                 blue accent bar is gone on purpose: on the frosted strip
                                 it read as a stray blue tick on the button's edge. -->
                            <Border x:Name="ActiveUnderline" Width="18" Height="2" CornerRadius="1" Background="#33FFFFFF" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}}" VerticalAlignment="Bottom" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=activeUnderline}" Visibility="Collapsed"/>
                            <VisualStateManager.VisualStateGroups>
                                <!-- Button states, matched to the web sidebar (web/css/app.css):
                                     default = transparent bg, muted text/icon (the style's
                                     Foreground setter); hover = surface-2 bg + white text
                                     (web .sidebar-item:hover); pressed = surface-3 bg + white
                                     text; focused = surface-2 bg + white text. The web's
                                     focused white inversion (.sidebar-item.focused: background
                                     #fff, color #000) is deliberately NOT ported: on the frosted
                                     strip it read as a bright pill with a white ring that clashed
                                     with the dark theme, in every state — focused, pressed and
                                     merely selected — so all four states stay in the dark theme
                                     and differ only in surface depth. The active (selected-page)
                                     look is owned by SetSidebarActive: surface-2 bg + white
                                     text + the underline below (a thin light transparent line
                                     under the icon, replacing the blue accent bar). -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <!-- The 130 ms state cross-fade and the 0.96 press shrink from
                                         build 241 are removed: that animation is not what Mohammed
                                         meant by button animation. The icon itself moves on focus
                                         arrival instead (MainPage.xaml.cs PlaySidebarIconAnimation),
                                         while state changes snap as before build 241. -->
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#29FFFFFF"/></ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#1AFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Black">
        <!-- Native Windows Media Foundation surface; controls are drawn by the native UI above it. -->
        <MediaPlayerElement x:Name="MediaElement" x:Load="False" SizeChanged="MediaElement_SizeChanged"
                            Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                            FlowDirection="LeftToRight" AreTransportControlsEnabled="False" Stretch="Uniform" />

        <!-- LibVLC fallback surface, used only when WMF cannot play a source. -->
        <vlc:VideoView x:Name="VideoView" x:Load="False"
                       SizeChanged="VideoView_SizeChanged" Opacity="0"
                       IsHitTestVisible="False" IsTabStop="False" />

        <!-- WebView2 is kept collapsed and never navigated in the native UI (M8 legacy import). -->
        <controls:WebView2 x:Name="WebView" FlowDirection="LeftToRight" Visibility="Collapsed" />

        <Grid x:Name="ShellGrid" Background="#FF0D0E13">
            <Grid.ColumnDefinitions>
                <!-- Column 0 is the flow-start edge (right in RTL, left in LTR): the
                     sidebar docks there by column, not by a one-time HorizontalAlignment
                     set in the constructor. Build 162 proved the constructor value can
                     disagree with the rendered direction (strip on the left while the
                     rows render RTL); the column follows the page's flow direction, so
                     the strip can no longer land on the wrong edge. -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Content fills the shell; the sidebar is an overlay on top of it (web:
                 position absolute, z-index 20), so expanding it never moves the content. -->
            <Frame x:Name="ContentFrame" Grid.Column="0" Grid.ColumnSpan="2" Navigated="ContentFrame_Navigated" NavigationFailed="ContentFrame_NavigationFailed"/>

            <!-- Collapsing sidebar: icons only (48 epx), expands to 136 epx when a sidebar button is focused or the pointer hovers (web: 6rem to 17rem, width .22s).
                 The divider is bound to the border's own FlowDirection ("divider"): it sits
                 on the content-facing edge (left in RTL), never on the outer edge against
                 the screen — build 180 showed a line and a gap on the outer edge.
                 Frosted glass: a custom Composition backdrop blur
                 (SidebarBackdropBlurBrush) — GaussianBlur 20 over the home backdrop
                 and rows behind the strip, with a dark tint composited on top.
                 Chosen over AcrylicBrush by Mohammed's call: full control of the
                 blur amount and tint, and a documented Xbox-compatible path
                 (HostBackdrop acrylic would render only the fallback on Xbox).
                 If the blur cannot be built, the brush falls back to the old
                 solid #111218 and logs, so the sidebar never breaks startup. -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="48" BorderBrush="#14FFFFFF" BorderThickness="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=divider}">
                <Border.Background>
                    <shared:SidebarBackdropBlurBrush/>
                </Border.Background>
                <!-- Logo on top (web: .sidebar-logo, 2.8rem icon, 3rem below it) and the
                     nav buttons vertically centered in the strip (web: .sidebar-items
                     flex 1, justify-content center, margin-top -6rem). The logo icon sits
                     at the same start offset as the button icons (8 epx panel + 8 epx
                     button padding); the NUVIO wordmark fades in with the labels on
                     expand, so the strip shows the icon alone when collapsed. -->
                <Grid Margin="8,19,8,19">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,24" FlowDirection="LeftToRight">
                        <!-- The collapsed icon is the wordmark's own triangle: a 22 epx
                             box holding the wordmark image at 22 epx high, clipped to
                             its left 22 epx so only the triangle shows. Build 241 proved
                             the old Canvas wrong: the triangle sat about 47 epx left of
                             the strip centre, clear of the divider over the hero. A Canvas
                             lays its 69.4 epx wide child out from the RTL flow-start edge,
                             so the 22 epx clip window landed 69.4 minus 22 = 47.4 epx left
                             of the cell. The b96c542 wordmark-overflow theory was wrong:
                             that triangle would straddle the divider at 901..923, not sit
                             clear of it. No Canvas any more: a plain 22 epx Grid, clipped
                             to its own bounds, in an explicitly LeftToRight row, so the
                             triangle is the image's physical left 22 epx, centred in the
                             32 epx cell on the button-icon column exactly like the other
                             icons. The LeftToRight is on this logo row only: the button
                             labels below still inherit RTL, so their alignment is
                             untouched. The wordmark is 69.4 epx wide in a 32 epx cell, so
                             it overflows past the strip on the content side while
                             collapsed; Opacity alone could not keep it hidden (build 232
                             showed the triangle outside the strip), so it is
                             Visibility=Collapsed when collapsed as well: AnimateSidebar
                             hides it the moment a collapse starts, not at the end of the
                             150 ms fade (while it stays Visible it paints "nuvio" past
                             the strip edge, and a superseded animation never pins its
                             end state), and the XAML default is Collapsed. The wordmark's play glyph is white on the gradient
                             in both states. The wordmark's triangle ends at 20 epx of the
                             22 epx height and its "nuvio" text starts at 24.3 epx, so the
                             22 epx clip shows the whole triangle and none of the text. The
                             wordmark is centered in the full row width when expanded
                             (build 216: start-aligned, its centre sat about 17 epx off
                             the strip's centre). The row itself carries no padding any
                             more, so the centring is exact. The two share one cell and
                             cross-fade (AnimateSidebar), never triangle + nuvio + triangle
                             as in build 162. -->
                        <Grid x:Name="SidebarLogoIcon" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,22,22"/>
                            </Grid.Clip>
                            <Image Source="ms-appx:///web/assets/wordmark.png" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <Image x:Name="SidebarLogoWordmark" Source="ms-appx:///web/assets/wordmark.png" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel x:Name="SidebarItemsPanel" Grid.Row="1" VerticalAlignment="Center" Margin="0,-48,0,0" Spacing="5">
                    <Button x:Name="HomeButton" Style="{StaticResource SidebarButtonStyle}" Tag="home" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE80F;" FontSize="14" VerticalAlignment="Center"><FontIcon.RenderTransform><CompositeTransform x:Name="HomeIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="HomeLabel" x:Uid="SidebarHomeLabel" Text="Home" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SearchButton" Style="{StaticResource SidebarButtonStyle}" Tag="search" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="14" VerticalAlignment="Center"><FontIcon.RenderTransform><CompositeTransform x:Name="SearchIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="SearchLabel" x:Uid="SidebarSearchLabel" Text="Search" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="LibraryButton" Style="{StaticResource SidebarButtonStyle}" Tag="library" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" FontSize="14" VerticalAlignment="Center"><FontIcon.RenderTransform><CompositeTransform x:Name="LibraryIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="LibraryLabel" x:Uid="SidebarLibraryLabel" Text="Library" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButtonStyle}" Tag="settings" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="14" VerticalAlignment="Center"><FontIcon.RenderTransform><CompositeTransform x:Name="SettingsIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="SettingsLabel" x:Uid="SidebarSettingsLabel" Text="Settings" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="ProfileButton" Style="{StaticResource SidebarButtonStyle}" Tag="profile" Visibility="Collapsed" Click="SidebarButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center"><FontIcon.RenderTransform><CompositeTransform x:Name="ProfileIconTransform" CenterX="7" CenterY="7"/></FontIcon.RenderTransform></FontIcon>
                            <TextBlock Grid.Column="2" x:Name="ProfileLabel" x:Uid="SidebarSwitchProfileLabel" Text="Switch profile" FontSize="10" VerticalAlignment="Center" Opacity="0" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}"/>
                        </Grid>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <Grid x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" IsHitTestVisible="False">
            <shared:ToastControl x:Name="Toast"/>
        </Grid>

        <Grid x:Name="LoadErrorPanel" Background="#FF0D0E13" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Padding="24" Spacing="16">
                <TextBlock x:Name="LoadErrorTitle" Text="Couldn't load Nuvio" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadErrorText" Foreground="#B3FFFFFF" TextWrapping="Wrap" TextAlignment="Left" FlowDirection="LeftToRight" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button x:Name="RetryButton" Content="Retry" MinWidth="160" />
                    <Button x:Name="BuiltInButton" Content="Use the built-in app" MinWidth="160" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
