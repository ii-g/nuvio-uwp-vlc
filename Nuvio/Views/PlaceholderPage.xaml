<!-- XYFocus keyboard navigation is off: the controller poll owns every move
     (see MainPage.OnPreviewKeyDown); otherwise the framework moves focus a
     second step per D-pad press on top of the router's move. -->
<views:FocusablePage
    x:Class="Nuvio.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Nuvio.Views"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="768" Padding="48">
            <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Message}" FontSize="18" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Milestone}" FontSize="16" Foreground="#80FFFFFF" TextAlignment="Center"/>
            <Button x:Name="BackButton" x:Uid="BackButton" Content="Back" MinWidth="160" HorizontalAlignment="Center" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</views:FocusablePage>
