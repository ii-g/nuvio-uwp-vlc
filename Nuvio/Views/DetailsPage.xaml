<!-- XYFocus keyboard navigation is off on purpose: the controller poll owns
     every move (see MainPage.OnPreviewKeyDown). Left on, the framework moves
     focus a second card per D-pad press on top of the router's move. -->
<Page
    x:Class="Nuvio.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:Nuvio.Views.Shared"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <Page.Resources>
        <!-- Focus frame shine (white only: shiny + translucent): NOT a shared
             resource — the gradient lives inline on each FocusRing Border, with
             7 named stops (bright 100% white peaks / 50% white valleys, periodic
             every 1.0 in offset) so the Focused/PointerFocused storyboards can
             slide every stop +1.0 over 3 s, forever, looping seamlessly. The
             bright band travels the frame while the element is focused. Single
             ring: the old static gradient + #FAFAFA inner ring read as a double
             frame, so the inner ring is gone. -->
        <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A62F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}">
                                <FontIcon Glyph="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                                <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                            </StackPanel>
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:FocusRingBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#CC3C7BFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeroActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}">
                                <FontIcon Glyph="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                                <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                            </StackPanel>
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:FocusRingBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#4DFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Season chips: the same glass button template, chip-sized. The selected
             chip's blue fill is set in code-behind (Background/Foreground). -->
        <Style x:Key="DetailsChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#B8FFFFFF"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:FocusRingBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#4DFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An episode card (components/cards.js episodeCard): 176x99 landscape art,
             watched check, progress bar, unreleased tag, E-number + title + overview. -->
        <DataTemplate x:Key="EpisodeCardTemplate">
            <Grid Width="176" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="99" Background="#FF16171D" CornerRadius="6">
                    <Grid>
                        <TextBlock Text="{Binding Code}" Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="6" FlowDirection="LeftToRight">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail, Converter={StaticResource PosterImageConverter}, ConverterParameter=wide}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibilityConverter}}" Width="15" Height="15" CornerRadius="8" Background="#A6000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                            <TextBlock Text="✓" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Visibility="{Binding Progress, Converter={StaticResource DoubleToVisibilityConverter}}" VerticalAlignment="Bottom" Margin="5,0,5,5" Height="2" Foreground="#FF3C7BFF" Background="#40FFFFFF"/>
                        <Border Visibility="{Binding UnreleasedTag, Converter={StaticResource StringToVisibilityConverter}}" Background="#A6000000" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
                            <TextBlock Text="{Binding UnreleasedTag}" Foreground="White" FontSize="7" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding EpisodeNumberText}" Foreground="#80FFFFFF" FontSize="8" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Overview}" Foreground="#B8FFFFFF" FontSize="8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- A cast card (TMDB): 64px round photo with initials behind it, name + role. -->
        <DataTemplate x:Key="CastCardTemplate">
            <Grid Width="88" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Width="64" Height="64" CornerRadius="32" Background="#FF16171D" HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initials}" Foreground="#80FFFFFF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="32" FlowDirection="LeftToRight">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Photo, Converter={StaticResource PosterImageConverter}, ConverterParameter=square}" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="8" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Character}" Foreground="#80FFFFFF" FontSize="7" TextAlignment="Center" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!-- Episode containers: the same glass gradient focus frame + 1.06 zoom as
             CardGridViewItemStyle, with the frame host pinned to the 99 epx art height
             (the shared CardArtHeightConverter returns 132 for an episode item, which
             would put the frame 33 epx too low). -->
        <Style x:Key="EpisodeGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                            <Grid VerticalAlignment="Top" IsHitTestVisible="False" Height="99">
                                <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="7" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <shared:SidebarBackdropBlurBrush/>
                                    </Border.BorderBrush>
                                </Border>
                                <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="7" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <shared:FocusRingBrush/>
                                    </Border.BorderBrush>
                                </Border>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected"/>
                                    <VisualState x:Name="Selected"/>
                                    <VisualState x:Name="SelectedUnfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Cast containers: the same frame + zoom, with the frame host pinned to the
             64 epx round photo (centered, so the host is 64 wide too). -->
        <Style x:Key="CastGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                            <Grid VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False" Width="64" Height="64">
                                <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="32" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <shared:SidebarBackdropBlurBrush/>
                                    </Border.BorderBrush>
                                </Border>
                                <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="32" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <shared:FocusRingBrush/>
                                    </Border.BorderBrush>
                                </Border>
                            </Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected"/>
                                    <VisualState x:Name="Selected"/>
                                    <VisualState x:Name="SelectedUnfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" XYFocusKeyboardNavigation="Disabled">
        <!-- Backdrop: the title's background, dissolving downward into the solid
             dark app background through a gradient alpha mask (BackdropFadeBrush,
             variant D). Hero focus keeps the image longer; focus on any row below
             fades it earlier. -->
        <Grid x:Name="BackdropHost" IsHitTestVisible="False">
            <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0"/>
            <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0"/>
            <Rectangle x:Name="BackdropFadeRect">
                <Rectangle.Fill>
                    <shared:BackdropFadeBrush x:Name="BackdropFade"/>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="ContentStack" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsContent}">
                <!-- Loading with no preview artwork yet: a centered spinner. -->
                <Grid Visibility="{Binding ShowLoadingSpinner, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="540">
                    <ProgressRing IsActive="True" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- The title: hero, episodes, credits, TMDB rows. -->
                <StackPanel Visibility="{Binding ShowContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Hero -->
                    <Grid x:Name="HeroSection" MinHeight="272">
                        <StackPanel VerticalAlignment="Bottom" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsHero}" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}}" MaxWidth="520">
                            <Image x:Name="HeroLogo" Source="{Binding LogoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter=logo}" Stretch="Uniform" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}}" MaxWidth="240" MaxHeight="80" Visibility="{Binding LogoUrl, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                            <Grid Visibility="{Binding LogoUrl, Converter={StaticResource InverseStringToVisibilityConverter}}">
                                <TextBlock x:Name="HeroTitle" Text="{Binding Title}" FontSize="27" FontWeight="ExtraBold" LineHeight="28" TextWrapping="Wrap" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,9,0,0">
                                <Grid Visibility="{Binding YearText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding YearText}" FontSize="9" Foreground="#B8FFFFFF" shared:TextGlow.IsEnabled="True"/>
                                </Grid>
                                <Grid Visibility="{Binding RuntimeText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding RuntimeText}" FontSize="9" Foreground="#B8FFFFFF" shared:TextGlow.IsEnabled="True"/>
                                </Grid>
                                <Grid Visibility="{Binding RatingText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" Foreground="White" shared:TextGlow.IsEnabled="True"/>
                                </Grid>
                                <Grid Visibility="{Binding TypeText, Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding TypeText}" FontSize="9" Foreground="#B8FFFFFF" shared:TextGlow.IsEnabled="True"/>
                                </Grid>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Genres}" Margin="0,9,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1FFFFFFF" CornerRadius="8" Padding="6,1">
                                            <Grid>
                                                <TextBlock Text="{Binding}" FontSize="8" shared:TextGlow.IsEnabled="True"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,9,0,0">
                                <TextBlock x:Name="HeroDescription" Text="{Binding Description}" FontSize="9" Foreground="#B8FFFFFF" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,13,0,0">
                                <Button x:Name="PlayButton" Content="{Binding PlayLabel}" Tag="&#xE768;" Style="{StaticResource HeroPrimaryButtonStyle}" Click="PlayButton_Click"/>
                                <Button x:Name="LibraryButton" Content="{Binding LibraryLabel}" Tag="&#xE8A4;" Style="{StaticResource HeroActionButtonStyle}" Click="LibraryButton_Click"/>
                                <Button x:Name="WatchedButton" Content="{Binding WatchedLabel}" Tag="&#xE73E;" Style="{StaticResource HeroActionButtonStyle}" Visibility="{Binding IsMovie, Converter={StaticResource BooleanToVisibilityConverter}}" Click="WatchedButton_Click"/>
                                <Button x:Name="TrailerButton" x:Uid="TrailerButton" Content="Trailer" Tag="&#xE714;" Style="{StaticResource HeroActionButtonStyle}" Visibility="{Binding HasTrailer, Converter={StaticResource BooleanToVisibilityConverter}}" Click="TrailerButton_Click"/>
                                <ProgressRing IsActive="{Binding IsLoading}" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Episodes -->
                    <StackPanel Visibility="{Binding HasEpisodes, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,13">
                        <Grid Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}">
                            <TextBlock x:Uid="EpisodesTitle" Text="Episodes" FontSize="12" FontWeight="Bold" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                        <StackPanel x:Name="SeasonChipsPanel" Orientation="Horizontal" Spacing="6" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}" />
                        <GridView x:Name="EpisodesGridView" ItemsSource="{Binding Episodes}" ItemTemplate="{StaticResource EpisodeCardTemplate}" ItemContainerStyle="{StaticResource EpisodeGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="EpisodesGridView_ItemClick" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <!-- Credits -->
                    <StackPanel Visibility="{Binding HasCredits, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}">
                        <ItemsControl ItemsSource="{Binding Credits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Label}" Foreground="#80FFFFFF" FontSize="9" Width="80" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Text}" FontSize="9" Foreground="White" TextWrapping="Wrap" MaxWidth="560"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Cast (TMDB) -->
                    <StackPanel Visibility="{Binding HasCast, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,13">
                        <Grid Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}">
                            <TextBlock x:Uid="CastTitle" Text="Cast" FontSize="12" FontWeight="Bold" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                        <GridView x:Name="CastGridView" ItemsSource="{Binding CastItems}" ItemTemplate="{StaticResource CastCardTemplate}" ItemContainerStyle="{StaticResource CastGridViewItemStyle}" SelectionMode="None" IsItemClickEnabled="False" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <!-- More Like This (TMDB) -->
                    <StackPanel Visibility="{Binding HasSimilar, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,13">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}">
                            <Grid>
                                <TextBlock x:Uid="MoreLikeThisTitle" Text="More Like This" FontSize="12" FontWeight="Bold" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="TMDB" FontSize="8" Foreground="#80FFFFFF" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                        </StackPanel>
                        <GridView x:Name="SimilarGridView" ItemsSource="{Binding SimilarItems}" ItemTemplate="{StaticResource PosterCardTemplate}" ItemContainerStyle="{StaticResource CardGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="SimilarGridView_ItemClick" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=detailsRowHeader}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </StackPanel>

                <!-- Load error -->
                <Grid Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="432">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                        <TextBlock x:Uid="FailedToLoadTitle" Text="Failed to load" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="RetryButton" x:Uid="RetryButton" Content="Retry" Style="{StaticResource HeroPrimaryButtonStyle}" Click="RetryButton_Click"/>
                            <Button x:Name="ErrorBackButton" x:Uid="BackButton" Content="Back" Style="{StaticResource HeroActionButtonStyle}" Click="ErrorBackButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
