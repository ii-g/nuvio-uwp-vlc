<!-- Player page — port of web/js/views/player.js layout from web/css/app.css.
     1rem = 8 epx on Xbox (web: 1rem is 1/120 of screen width; the Xbox app
     renders at a scaled 960x540). The web player is direction:ltr, so the
     root grid is pinned LeftToRight even in Arabic; Arabic titles and
     subtitles still shape correctly through the Unicode bidi algorithm.
     Background is transparent: the video surfaces live under the shell
     Frame and show through. The OSD stays Visible with Opacity 0 when
     hidden (NOT Collapsed) so focus can stay on its buttons. -->
<views:FocusablePage
    x:Class="Nuvio.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:Nuvio.Views.Shared"
    xmlns:views="using:Nuvio.Views"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <views:FocusablePage.Resources>
        <!-- Circular OSD icon button: web .osd-btn, 4rem (32 epx), icon 2rem
             (16 epx). Focused: white background, black glyph, 1.08 scale, and
             the standard white 3 epx focus ring (Margin -1, Opacity 0 to 1). -->
        <Style x:Key="OsdIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="16" Background="{TemplateBinding Background}"/>
                            <FontIcon x:Name="Icon" Glyph="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="16" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#2EFFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Icon" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Icon" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same circle, but the content is text (the speed button shows the
             current rate, e.g. "1.5x"): no Segoe MDL2 glyph for speed exists. -->
        <Style x:Key="OsdTextButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="16" Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="Label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="16" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#2EFFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#33FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Label" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Black"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rectangular buttons: web .btn (height 3.5rem = 28, padding
             0 1.8rem = 0/14, radius 1.75rem = 14, font 1.15rem = 9).
             Primary is the accent blue; secondary is surface-2 white 10%.
             Focused: white background, black text, 1.05 scale. -->
        <Style x:Key="PlayerPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF3C7BFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#29FFFFFF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bg" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seek bar button: transparent overlay over the track visuals
             (the fill/thumb/preview are siblings in the page, positioned by
             code-behind, because template parts are not reachable from here).
             Focused: white 3 epx ring; the track grows and the thumb scales
             via the page's GotFocus/LostFocus handlers. -->
        <Style x:Key="SeekBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="4" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:FocusablePage.Resources>

    <!-- Web .player is direction:ltr; the OSD keeps that layout in Arabic too. -->
    <Grid x:Name="RootGrid" Background="Transparent" FlowDirection="LeftToRight">

        <!-- (a) Addon subtitle overlay: web .player-subs, left/right 8%,
             bottom = subtitleOffset% (raised to 13rem = 104 epx while the
             OSD is visible). Font size, colour and position are applied by
             the page from the ViewModel's subtitle style props. -->
        <Border x:Name="SubtitleBackgroundBorder"
                Visibility="{Binding CurrentSubtitleText, Converter={StaticResource StringToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                IsHitTestVisible="False">
            <TextBlock x:Name="SubtitleTextBlock"
                       Text="{Binding CurrentSubtitleText}"
                       FontSize="19" FontWeight="SemiBold" Foreground="White"
                       TextAlignment="Center" TextWrapping="Wrap"
                       IsHitTestVisible="False"
                       shared:TextGlow.IsEnabled="True"/>
        </Border>

        <!-- (b) Loading overlay: web .player-loading, black, backdrop cover
             at 25% opacity, logo (max 26rem x 9rem = 208x72) or title
             (2.6rem = 21, weight 800), spinner, loading text (1.15rem = 9). -->
        <Grid x:Name="LoadingOverlay" Background="Black"
              Visibility="{Binding IsLoadingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image x:Name="LoadingBackdrop"
                   Source="{Binding BackdropUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter=landscape}"
                   Visibility="{Binding BackdropUrl, Converter={StaticResource StringToVisibilityConverter}}"
                   Stretch="UniformToFill" Opacity="0.25" IsHitTestVisible="False"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                <Image x:Name="LoadingLogo"
                       Source="{Binding LoadingLogoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter=logo}"
                       Visibility="{Binding LoadingLogoUrl, Converter={StaticResource StringToVisibilityConverter}}"
                       MaxWidth="208" MaxHeight="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock x:Name="LoadingTitle" Text="{Binding TitleText}"
                           Visibility="{Binding LoadingLogoUrl, Converter={StaticResource InverseStringToVisibilityConverter}}"
                           FontSize="21" FontWeight="ExtraBold" Foreground="White"
                           TextAlignment="Center" HorizontalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                <ProgressRing IsActive="True" Width="32" Height="32" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LoadingText}" FontSize="9" Foreground="#B8FFFFFF"
                           TextAlignment="Center" HorizontalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
            </StackPanel>
        </Grid>

        <!-- (c) OSD. Opacity 0/1 (never Collapsed) + IsHitTestVisible, driven
             by the page from ControlsVisible/Ready. -->
        <Grid x:Name="OsdRoot" Opacity="0" IsHitTestVisible="False">
            <!-- Top scrim: linear-gradient(180deg, black 75%, transparent). -->
            <Rectangle x:Name="OsdTopScrim" VerticalAlignment="Top" Height="120" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#BF000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Bottom scrim: linear-gradient(0deg, black 85%, transparent). -->
            <Rectangle x:Name="OsdBottomScrim" VerticalAlignment="Bottom" Height="170" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#D9000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top row: Back (3.4rem = 27), title, source. Padding
                     2.6rem 4.5rem 6rem = 21 / 36 / 48. -->
                <Grid Grid.Row="0" Margin="36,21,36,48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Style="{StaticResource OsdIconButtonStyle}" Width="27" Height="27" Tag="&#xE72B;" Click="BackButton_Click" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1" shared:TextGlow.IsEnabled="True"/>
                        <TextBlock Text="{Binding EpisodeText}" Visibility="{Binding EpisodeText, Converter={StaticResource StringToVisibilityConverter}}" FontSize="9" Foreground="#B8FFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1" shared:TextGlow.IsEnabled="True"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" Visibility="{Binding SourceLabel, Converter={StaticResource StringToVisibilityConverter}}" FontSize="8" FontWeight="SemiBold" Foreground="#80FFFFFF" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                </Grid>

                <!-- Centre flash: web .osd-flash, 7rem (56) circle, black 45%,
                     icon 3rem (24). Shown briefly on play/pause toggles. -->
                <Border x:Name="FlashBorder" Grid.Row="1" Width="56" Height="56" CornerRadius="28"
                        Background="#73000000" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0" IsHitTestVisible="False">
                    <FontIcon x:Name="FlashIcon" Glyph="&#xE768;" FontSize="24" Foreground="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Bottom: timeline + controls. Padding 7rem 4.5rem 2.6rem
                     = 56 / 36 / 21; gap 1.2rem = 10. -->
                <Grid x:Name="OsdBottom" Grid.Row="2" Margin="36,56,36,21">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Timeline: time (min 5.5rem = 44), seek bar, remaining. -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" FontSize="9" FontWeight="SemiBold" Foreground="White" MinWidth="44" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                        <Grid x:Name="SeekBarArea" Grid.Column="1" Margin="11,0">
                            <!-- web .seek-track: height .35rem (3), white 28%, radius .2rem (2). -->
                            <Border x:Name="SeekTrack" Height="3" Background="#47FFFFFF" CornerRadius="2" VerticalAlignment="Center"/>
                            <Border x:Name="SeekFill" Height="3" Background="White" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                            <Ellipse x:Name="SeekThumb" Width="10" Height="10" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="SeekThumbScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- web .seek-preview: shown while scrubbing, above the track. -->
                            <Border x:Name="SeekPreview" Background="White" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Collapsed">
                                <TextBlock x:Name="SeekPreviewText" Text="{Binding ScrubPreviewText}" FontSize="9" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                            <Button x:Name="SeekBar" Style="{StaticResource SeekBarButtonStyle}" Click="SeekBar_Click" GotFocus="SeekBar_GotFocus" LostFocus="SeekBar_LostFocus"/>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" FontSize="9" FontWeight="SemiBold" Foreground="#B8FFFFFF" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                    </Grid>
                    <!-- Controls row: transport group left, menus group right. -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="RewindButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xEB9E;" Click="RewindButton_Click"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource OsdIconButtonStyle}" Tag="{Binding PlayPauseGlyph}" Click="PlayPauseButton_Click"/>
                            <Button x:Name="ForwardButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xEB9D;" Click="ForwardButton_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="SubtitlesButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xE8BA;" Click="SubtitlesButton_Click"/>
                            <Button x:Name="AudioButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xE767;" Click="AudioButton_Click"/>
                            <Button x:Name="SpeedButton" Style="{StaticResource OsdTextButtonStyle}" Content="{Binding RateText}" Click="SpeedButton_Click"/>
                            <Button x:Name="AspectButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xE799;" Click="AspectButton_Click"/>
                            <Button x:Name="SourcesButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xE8AB;" Click="SourcesButton_Click"
                                    Visibility="{Binding HasMultipleSources, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button x:Name="EpisodesButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xE71D;" Click="EpisodesButton_Click"
                                    Visibility="{Binding IsSeries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button x:Name="NextButton" Style="{StaticResource OsdIconButtonStyle}" Tag="&#xE893;" Click="NextButton_Click"
                                    Visibility="{Binding IsSeries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- (d) Next-episode card: web .player-next, inset-inline-end 4.5rem
             (36), bottom 4rem (32), width 34rem (272), padding 1.2rem (10),
             radius 1rem (8), background rgba(18,19,25,.95). Thumb 12rem (96)
             16:9. Label .95rem (8) accent-strong; card buttons 3rem (24). -->
        <Grid x:Name="NextCard" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,32"
              Visibility="{Binding IsNextVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#F2121319" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10" Width="272">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="54" CornerRadius="6" Margin="0,0,10,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding NextThumbnail, Converter={StaticResource PosterImageConverter}, ConverterParameter=landscape}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding NextLabel}" FontSize="8" FontWeight="Bold" Foreground="#FF3C7BFF"/>
                        <TextBlock Text="{Binding NextTitle}" FontSize="9" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <Button x:Name="NextPlayButton" Style="{StaticResource PlayerPrimaryButtonStyle}" Height="24" Padding="10,0" FontSize="8" CornerRadius="12" Click="NextPlayButton_Click"/>
                            <Button x:Name="NextCancelButton" Style="{StaticResource PlayerSecondaryButtonStyle}" Height="24" Padding="10,0" FontSize="8" CornerRadius="12" Click="NextCancelButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- (e) Error box: web .player-error, black 90%, centred, gap
             1.1rem (9), padding 2rem (16); icon 4rem (32) #FFB3B5; title
             2rem (16); message max-width 50rem (400). -->
        <Grid x:Name="ErrorBox" Background="#E6000000"
              Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9" MaxWidth="400" Margin="16">
                <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="#FFFFB3B5" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ErrorTitleText" FontSize="16" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="TryNextButton" Style="{StaticResource PlayerPrimaryButtonStyle}"
                            Visibility="{Binding HasNextSource, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="TryNextButton_Click"/>
                    <Button x:Name="RetryButton" Style="{StaticResource PlayerSecondaryButtonStyle}" Click="RetryButton_Click"/>
                    <Button x:Name="ChooseAnotherButton" Style="{StaticResource PlayerSecondaryButtonStyle}" Click="ChooseAnotherButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</views:FocusablePage>
