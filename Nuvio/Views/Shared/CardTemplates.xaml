<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Nuvio.Views">

    <!-- Shared value converters (classes live in Views/HomePage.xaml.cs). -->
    <views:PosterImageConverter x:Key="PosterImageConverter"/>
    <views:ShapeWidthConverter x:Key="ShapeWidthConverter"/>
    <views:ShapeHeightConverter x:Key="ShapeHeightConverter"/>
    <views:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    <views:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <views:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
    <views:DoubleToVisibilityConverter x:Key="DoubleToVisibilityConverter"/>
    <views:ContinueProgressVisibilityConverter x:Key="ContinueProgressVisibilityConverter"/>

    <!-- A poster card (components/cards.js posterCard): art, watched check, progress bar, title. -->
    <DataTemplate x:Key="PosterCardTemplate">
        <Grid Width="{Binding Meta.PosterShape, Converter={StaticResource ShapeWidthConverter}}" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="{Binding Meta.PosterShape, Converter={StaticResource ShapeHeightConverter}}" Background="#FF16171D" CornerRadius="12">
                <Grid>
                    <TextBlock Text="{Binding Meta.Name}" Foreground="#80FFFFFF" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
                    <Image Source="{Binding Meta.Poster, Converter={StaticResource PosterImageConverter}, ConverterParameter=poster}" Stretch="UniformToFill"/>
                    <Border Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibilityConverter}}" Width="30" Height="30" CornerRadius="15" Background="#A6000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9">
                        <TextBlock Text="✓" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar Value="{Binding Progress}" Maximum="1" Visibility="{Binding Progress, Converter={StaticResource DoubleToVisibilityConverter}}" VerticalAlignment="Bottom" Margin="11,0,11,11" Height="5" Foreground="#FF3C7BFF" Background="#40FFFFFF"/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding Meta.Name}" Foreground="#B8FFFFFF" FontSize="16" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </Grid>
    </DataTemplate>

    <!-- The trailing "View All" card at the end of a row (components/cards.js viewAllCard). -->
    <DataTemplate x:Key="ViewAllCardTemplate">
        <Grid Width="{Binding Meta.PosterShape, Converter={StaticResource ShapeWidthConverter}}" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="{Binding Meta.PosterShape, Converter={StaticResource ShapeHeightConverter}}" Background="#0FFFFFFF" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE76C;" FontSize="38" Foreground="#B8FFFFFF"/>
                    <TextBlock x:Uid="ViewAllLabel" Text="View All" Foreground="#B8FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text=" " FontSize="16" Margin="0,9,0,0"/>
        </Grid>
    </DataTemplate>

    <views:CatalogCardTemplateSelector x:Key="CatalogCardSelector" PosterTemplate="{StaticResource PosterCardTemplate}" ViewAllTemplate="{StaticResource ViewAllCardTemplate}"/>

    <!-- A Continue Watching card (components/cards.js continueCard): wide art, logo-or-title, progress, Next Up tag, sub-line. -->
    <DataTemplate x:Key="ContinueCardTemplate">
        <Grid Width="352" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="198" Background="#FF16171D" CornerRadius="12">
                <Grid>
                    <TextBlock Text="{Binding Title}" Foreground="#80FFFFFF" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
                    <Image Source="{Binding CardImage, Converter={StaticResource PosterImageConverter}, ConverterParameter=wide}" Stretch="UniformToFill"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000"/>
                                <GradientStop Offset="1" Color="#BF000000"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Image Source="{Binding Logo, Converter={StaticResource PosterImageConverter}, ConverterParameter=logo}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,26" MaxWidth="190" MaxHeight="64" Visibility="{Binding Logo, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,16,26" Visibility="{Binding Logo, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                    <ProgressBar Value="{Binding ProgressFraction}" Maximum="1" Visibility="{Binding Converter={StaticResource ContinueProgressVisibilityConverter}}" VerticalAlignment="Bottom" Margin="11,0,11,11" Height="5" Foreground="#FF3C7BFF" Background="#40FFFFFF"/>
                    <Border Visibility="{Binding NextUp, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FF2F6FED" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="{Binding TagText}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding DisplaySubLine}" Foreground="#80FFFFFF" FontSize="15" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </Grid>
    </DataTemplate>

    <!-- Card containers: focus ring + zoom (web: scale 1.06 + white ring). Selection is off; click is via IsItemClickEnabled. -->
    <Style x:Key="CardGridViewItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,18,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        <Border x:Name="FocusRing" BorderBrush="White" BorderThickness="0" CornerRadius="12" IsHitTestVisible="False"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="BorderThickness"><DiscreteObjectKeyFrame KeyTime="0" Value="2"/></ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="BorderBrush"><DiscreteObjectKeyFrame KeyTime="0" Value="#99FFFFFF"/></ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="BorderThickness"><DiscreteObjectKeyFrame KeyTime="0" Value="3.5"/></ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="BorderBrush"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="BorderThickness"><DiscreteObjectKeyFrame KeyTime="0" Value="3.5"/></ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="BorderBrush"><DiscreteObjectKeyFrame KeyTime="0" Value="White"/></ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected"/>
                                <VisualState x:Name="Selected"/>
                                <VisualState x:Name="SelectedUnfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
