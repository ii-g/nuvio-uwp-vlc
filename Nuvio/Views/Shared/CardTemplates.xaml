<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Nuvio.Views"
    xmlns:shared="using:Nuvio.Views.Shared">

    <!-- Shared value converters (classes live in Views/HomePage.xaml.cs). -->
    <views:PosterImageConverter x:Key="PosterImageConverter"/>
    <views:ShapeWidthConverter x:Key="ShapeWidthConverter"/>
    <views:ShapeHeightConverter x:Key="ShapeHeightConverter"/>
    <views:CardArtHeightConverter x:Key="CardArtHeightConverter"/>
    <views:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    <views:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    <views:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
    <views:DoubleToVisibilityConverter x:Key="DoubleToVisibilityConverter"/>
    <views:ContinueProgressVisibilityConverter x:Key="ContinueProgressVisibilityConverter"/>
    <views:ViewAllArrowConverter x:Key="ViewAllArrowConverter"/>
    <views:FlowDirectionToHorizontalAlignmentConverter x:Key="FlowDirectionToHorizontalAlignmentConverter"/>
    <views:FlowDirectionToTextAlignmentConverter x:Key="FlowDirectionToTextAlignmentConverter"/>
    <views:FlowDirectionToThicknessConverter x:Key="FlowDirectionToThicknessConverter"/>

    <!-- Focus frame shine (white only: shiny + translucent): NOT a shared
         resource — the gradient lives inline on each FocusRing Border, with
         7 named stops (bright 100% white peaks / 50% white valleys, periodic
         every 1.0 in offset) so the Focused/PointerFocused storyboards can
         slide every stop +1.0 over 3 s, forever, looping seamlessly. The
         bright band travels the frame while the element is focused. Single
         ring: the old static gradient + #FAFAFA inner ring read as a double
         frame, so the inner ring is gone. -->

    <!-- A poster card (components/cards.js posterCard): art, watched check, progress bar, title. -->
    <DataTemplate x:Key="PosterCardTemplate">
        <Grid Width="{Binding Meta.PosterShape, Converter={StaticResource ShapeWidthConverter}}" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="{Binding Meta.PosterShape, Converter={StaticResource ShapeHeightConverter}}" Background="#FF16171D" CornerRadius="6">
                <Grid>
                    <TextBlock Text="{Binding Meta.Name}" Foreground="#80FFFFFF" FontSize="8" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
                    <!-- Art as the Border background: Border.CornerRadius does not clip a child
                         Image, so the poster's square corners poked out of the rounded frame.
                         The background brush is clipped to the corners; the name text shows
                         through only while the art is missing. -->
                    <!-- The art host is pinned LeftToRight: an ImageBrush inherits the page's
                         RTL flow and mirrors the poster (build 162 showed every poster
                         flipped); the title text below stays RTL. -->
                    <Border CornerRadius="6" FlowDirection="LeftToRight">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Meta.Poster, Converter={StaticResource PosterImageConverter}, ConverterParameter=poster}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibilityConverter}}" Width="15" Height="15" CornerRadius="8" Background="#A6000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                        <TextBlock Text="✓" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar Value="{Binding Progress}" Maximum="1" Visibility="{Binding Progress, Converter={StaticResource DoubleToVisibilityConverter}}" VerticalAlignment="Bottom" Margin="5,0,5,5" Height="2" Foreground="#FF3C7BFF" Background="#40FFFFFF"/>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding Meta.Name}" Foreground="#B8FFFFFF" FontSize="8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </Grid>
    </DataTemplate>

    <!-- The catalog's poster card: the same art + watched check + progress +
         title as PosterCardTemplate, but with NO plate behind the art. The
         shared template's outer Border (Background #FF16171D) reads as a
         visible outline around every poster on the catalog page (its edge
         and the rounded-corner anti-aliasing fringe show against the page
         background), so here the art host is a plain Grid and the art
         paints edge-to-edge. Home rows keep PosterCardTemplate unchanged. -->
    <!-- Catalog cards are a fixed 70x105 (2:3): smaller than the home 88x132
         so 10 columns fit the 772 epx viewport (10x77-7=763) and about 39
         cards are visible at once instead of 24. The size is fixed here, not
         driven by the shared shape converters, so home rows keep their
         PosterSize-driven sizes and the catalog ignores Meta.PosterShape. -->
    <DataTemplate x:Key="CatalogPosterCardTemplate">
        <Grid Width="70" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="105">
                <TextBlock Text="{Binding Meta.Name}" Foreground="#80FFFFFF" FontSize="8" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
                <!-- Art as the Border background: Border.CornerRadius does not clip a child
                     Image, so the poster's square corners poked out of the rounded frame.
                     The background brush is clipped to the corners; the name text shows
                     through only while the art is missing. -->
                <!-- The art host is pinned LeftToRight: an ImageBrush inherits the page's
                     RTL flow and mirrors the poster (build 162 showed every poster
                     flipped); the title text below stays RTL. -->
                <Border CornerRadius="6" FlowDirection="LeftToRight">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Meta.Poster, Converter={StaticResource PosterImageConverter}, ConverterParameter=poster}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Border Visibility="{Binding IsWatched, Converter={StaticResource BooleanToVisibilityConverter}}" Width="15" Height="15" CornerRadius="8" Background="#A6000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                    <TextBlock Text="✓" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ProgressBar Value="{Binding Progress}" Maximum="1" Visibility="{Binding Progress, Converter={StaticResource DoubleToVisibilityConverter}}" VerticalAlignment="Bottom" Margin="5,0,5,5" Height="2" Foreground="#FF3C7BFF" Background="#40FFFFFF"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Meta.Name}" Foreground="#B8FFFFFF" FontSize="8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </Grid>
    </DataTemplate>

    <!-- The trailing "View All" card at the end of a row (components/cards.js viewAllCard):
         a full poster-sized empty card, transparent so the hero shows through (the web
         surface token is rgba(255,255,255,.06), exactly #0FFFFFFF), chevron + label centred.
         It binds the item's own PosterShape, not Meta.PosterShape: the View All item
         has no Meta, so the Meta binding failed and the card collapsed to a small
         content-sized chip in build 180. The arrow is chevron-right in either direction
         (web icon('chevron-right'), unconditional). -->
    <DataTemplate x:Key="ViewAllCardTemplate">
        <Grid Width="{Binding PosterShape, Converter={StaticResource ShapeWidthConverter}}" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="{Binding PosterShape, Converter={StaticResource ShapeHeightConverter}}" Background="#0FFFFFFF" CornerRadius="6">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                    <FontIcon Glyph="{Binding IsViewAll, Converter={StaticResource ViewAllArrowConverter}}" FontSize="19" Foreground="#B8FFFFFF"/>
                    <TextBlock x:Uid="ViewAllLabel" Text="View All" Foreground="#B8FFFFFF" FontSize="8" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text=" " FontSize="8" Margin="0,4,0,0"/>
        </Grid>
    </DataTemplate>

    <views:CatalogCardTemplateSelector x:Key="CatalogCardSelector" PosterTemplate="{StaticResource PosterCardTemplate}" ViewAllTemplate="{StaticResource ViewAllCardTemplate}"/>

    <!-- A Continue Watching card (components/cards.js continueCard): wide art, logo-or-title, progress, Next Up tag, sub-line. -->
    <DataTemplate x:Key="ContinueCardTemplate">
        <Grid Width="176" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="99" Background="#FF16171D" CornerRadius="6">
                <Grid>
                    <TextBlock Text="{Binding Title}" Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
                    <!-- Art as the Border background (see PosterCardTemplate): the child Image
                         was not clipped to the rounded corners. -->
                    <!-- Art host pinned LeftToRight (see PosterCardTemplate): the brush must
                         not mirror in RTL. -->
                    <Border CornerRadius="6" FlowDirection="LeftToRight">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CardImage, Converter={StaticResource PosterImageConverter}, ConverterParameter=wide}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000"/>
                                <GradientStop Offset="1" Color="#BF000000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Image Source="{Binding Logo, Converter={StaticResource PosterImageConverter}, ConverterParameter=logo}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,13" MaxWidth="97" MaxHeight="32" Visibility="{Binding Logo, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,8,13" Visibility="{Binding Logo, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                    <ProgressBar Value="{Binding ProgressFraction}" Maximum="1" Visibility="{Binding Converter={StaticResource ContinueProgressVisibilityConverter}}" VerticalAlignment="Bottom" Margin="5,0,5,5" Height="2" Foreground="#FF3C7BFF" Background="#40FFFFFF"/>
                    <Border Visibility="{Binding NextUp, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#FF2F6FED" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
                        <TextBlock Text="{Binding TagText}" Foreground="White" FontSize="7" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding DisplaySubLine}" Foreground="#80FFFFFF" FontSize="8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </Grid>
    </DataTemplate>

    <!-- Card containers: glass focus frame + zoom. The frame is a single
         3 epx white shine border (7 named gradient stops, bright 100% white
         peaks / 50% white valleys) over a frosted blur band
         (SidebarBackdropBlurBrush, GaussianBlur 20), on the focused card
         only; the shine travels the frame while focused (3 s loop). It
         replaces the old white ring (1.25 hover / 1.75 focus) and the F
         sheen (FocusSheen, removed): one frame, no sheen, no glow. The
         old static gradient + #FAFAFA inner ring read as a double frame,
         so the inner ring is gone. Selection is off; click is via
         IsItemClickEnabled. The framework also draws its own focus
         rectangle around the whole item (art + title) unless
         UseSystemFocusVisuals is off; with the template's art-only frame
         that made two overlapping frames, so the system one is disabled
         and the template frame is the only one. -->
    <Style x:Key="CardGridViewItemStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,9,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        <!-- The frame wraps the art only, 3 epx, CornerRadius 7 (the
                             focus ring's radius, not the site's 20), with the title
                             outside it. The host Grid is the art height, so the frame
                             never swallows the title; the frame stretches inside it
                             with Margin -1, so it sits 1 epx outside the art on all
                             four sides. (An explicit Height on the frame itself did
                             not do this: with VerticalAlignment Top the -1 margin
                             only shifted the frame up 1 epx, so its bottom edge sat
                             1 epx above the art's bottom edge and the poster leaked
                             out below it.) Two layers, all Opacity 0 until focus:
                             FocusGlassBand (frosted blur band) and FocusRing
                             (white shine border: shared:FocusRingBrush slides its 7 stops
                             +1.0 over 3 s on the compositor while focused). -->
                        <Grid VerticalAlignment="Top" IsHitTestVisible="False" Height="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CardArtHeightConverter}}">
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="7" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="7" Margin="-1" Opacity="0" IsHitTestVisible="False" shared:FocusRingBrush.RestartOnFocus="True">
                                <Border.BorderBrush>
                                    <shared:FocusRingBrush/>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected"/>
                                <VisualState x:Name="Selected"/>
                                <VisualState x:Name="SelectedUnfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Catalog grid containers: the same card + 1.06 focus zoom as
         CardGridViewItemStyle, with the same glass gradient focus frame.
         (The old ring was dropped here because in the catalog's
         ItemsWrapGrid it rendered as a thin rectangle inside the poster
         (build 224 photo) instead of wrapping the art as it does in the
         home rows (ItemsStackPanel); the frame now uses the same host
         Grid as the home style, so it is back on the same terms. Watch
         the visual test for a repeat of the build 224 rectangle.) -->
    <Style x:Key="CatalogGridViewItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource CardGridViewItemStyle}">
        <!-- Narrower item gap than the home rows (7 epx, not 9): the catalog
             viewport is 772 epx wide (RTL) and a cell is 70 epx + the gap, so
             with 9 the cell is 79 and 10 columns need 10x79-9=781, over the
             viewport, so only 9 fit; with 7 the cell is 77 and 10x77-7=763
             fits, so all 10 columns fill the width.
             The first column stays on the home content edge (x=804 RTL).
             The focus ring host is a fixed 105 tall to match the 70x105 art
             (the shared CardArtHeightConverter returns 132 for the home size). -->
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        <Grid VerticalAlignment="Top" IsHitTestVisible="False" Height="105">
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="7" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="7" Margin="-1" Opacity="0" IsHitTestVisible="False" shared:FocusRingBrush.RestartOnFocus="True">
                                <Border.BorderBrush>
                                    <shared:FocusRingBrush/>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="PointerFocused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected"/>
                                <VisualState x:Name="Selected"/>
                                <VisualState x:Name="SelectedUnfocused"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
