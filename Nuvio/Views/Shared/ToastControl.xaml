<UserControl
    x:Class="Nuvio.Views.Shared.ToastControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border x:Name="ToastBorder" CornerRadius="32" Background="#F21E1F26" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="24,14" Opacity="0" Visibility="Collapsed" HorizontalAlignment="Center">
        <TextBlock x:Name="ToastText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="900"/>
    </Border>
</UserControl>
