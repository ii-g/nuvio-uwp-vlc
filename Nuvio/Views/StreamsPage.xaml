<!-- Streams page (Milestone 4): stream list for one title/episode.
     Ported from web/js/views/streams.js + web/css/app.css (.streams-*).
     Layout in epx (web rem x 8): info column 240, gap 24, layout padding
     content-start + visual anchor / 28 top (set in code-behind so RTL flips
     the sides), chips 22 high, stream rows 72 / 1fr / auto with 9,10 padding.
     XYFocus keyboard navigation is off on purpose: the controller poll owns
     every move (see MainPage.OnPreviewKeyDown). Left on, the framework moves
     focus a second card per D-pad press on top of the router's move. -->
<views:FocusablePage
    x:Class="Nuvio.Views.StreamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:Nuvio.Views.Shared"
    xmlns:local="using:Nuvio.Views"
    xmlns:views="using:Nuvio.Views"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <views:FocusablePage.Resources>
        <!-- Filter chips: the web .chip (22 high, radius 11, font 8) on the
             same glass button template as the Details season chips. The
             selected chip's blue fill is set in code-behind. -->
        <Style x:Key="StreamsChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#B8FFFFFF"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#4DFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Primary button (Manage Addons): the web .btn (28 high, radius 14,
             font 9) on the same glass template as the Details hero buttons. -->
        <Style x:Key="StreamsPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A62F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#CC3C7BFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A stream row (web .stream-item): resolution badge + addon name,
             name + detail + badges, cached/debrid/size/unsupported side.
             Non-playable rows render at half opacity (web .disabled). -->
        <DataTemplate x:Key="StreamItemTemplate">
            <Border Background="#8C0D0E13" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="6" Padding="9,10" Opacity="{Binding IsPlayable, Converter={StaticResource StreamRowOpacityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ColumnSpacing>10</Grid.ColumnSpacing>
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="{Binding Resolution}" Foreground="White" FontSize="11" FontWeight="ExtraBold" Visibility="{Binding Resolution, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                        <TextBlock Text="{Binding AddonName}" Foreground="#80FFFFFF" FontSize="7" FontWeight="SemiBold" TextWrapping="Wrap" shared:TextGlow.IsEnabled="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" shared:TextGlow.IsEnabled="True"/>
                        <TextBlock Text="{Binding Detail}" Foreground="#B8FFFFFF" FontSize="8" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                        <ItemsControl ItemsSource="{Binding Badges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1FFFFFFF" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding}" Foreground="#B8FFFFFF" FontSize="7" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CachedLabel}" Foreground="#FFFFD54F" FontSize="8" FontWeight="SemiBold" TextAlignment="Right" Visibility="{Binding CachedLabel, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                        <TextBlock Text="{Binding DebridLabel}" Foreground="#80FFFFFF" FontSize="8" FontWeight="SemiBold" TextAlignment="Right" Visibility="{Binding DebridLabel, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                        <TextBlock Text="{Binding SizeText}" Foreground="#B8FFFFFF" FontSize="8" FontWeight="SemiBold" TextAlignment="Right" Visibility="{Binding SizeText, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                        <TextBlock Text="{Binding UnsupportedTag}" Foreground="#80FFFFFF" FontSize="8" FontWeight="SemiBold" TextAlignment="Right" Visibility="{Binding UnsupportedTag, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Stream row containers: the plain white focus ring, 3 epx, Margin -1,
             Opacity 0 until Focused/PointerFocused (PointerOver on rows). No
             zoom: a full-width row must not scale. -->
        <Style x:Key="StreamsListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="FocusRing" BorderThickness="3" CornerRadius="6" Margin="-1" Opacity="0" IsHitTestVisible="False" BorderBrush="White"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected"/>
                                    <VisualState x:Name="Selected"/>
                                    <VisualState x:Name="SelectedUnfocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:StreamRowOpacityConverter x:Key="StreamRowOpacityConverter"/>
    </views:FocusablePage.Resources>

    <Grid x:Name="RootGrid" XYFocusKeyboardNavigation="Disabled">
        <!-- Backdrop: the title's background, cross-faded between two layers
             and dissolved downward into the dark background (BackdropFadeBrush,
             variant D, same as DetailsPage). -->
        <Grid x:Name="BackdropHost" IsHitTestVisible="False" FlowDirection="LeftToRight">
            <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0"/>
            <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0"/>
            <Rectangle x:Name="BackdropFadeRect">
                <Rectangle.Fill>
                    <shared:BackdropFadeBrush x:Name="BackdropFade"/>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Web .streams-layout: info aside 240 + main column, gap 24.
             Padding is set in code-behind (content-start + visual anchor,
             28 top) so RTL flips the sides like padding-inline does on the web. -->
        <Grid x:Name="LayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.ColumnSpacing>24</Grid.ColumnSpacing>

            <!-- Info aside (web .streams-info): logo or title, episode code +
                 name, thumbnail, description. -->
            <StackPanel Grid.Column="0" Spacing="9" Margin="0,16,0,0">
                <Image Source="{Binding LogoUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter=logo}" Stretch="Uniform" HorizontalAlignment="Left" FlowDirection="LeftToRight" MaxWidth="192" MaxHeight="64" Visibility="{Binding LogoUrl, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                <Grid Visibility="{Binding LogoUrl, Converter={StaticResource InverseStringToVisibilityConverter}}">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="21" FontWeight="ExtraBold" LineHeight="22" TextWrapping="Wrap" shared:TextGlow.IsEnabled="True"/>
                </Grid>
                <StackPanel Spacing="2" Visibility="{Binding HasVideo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding EpisodeCode}" Foreground="#FF3C7BFF" FontSize="8" FontWeight="Bold" Visibility="{Binding EpisodeCode, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                    <TextBlock Text="{Binding EpisodeName}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding EpisodeName, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                </StackPanel>
                <Border Height="135" CornerRadius="6" FlowDirection="LeftToRight" Visibility="{Binding ThumbnailUrl, Converter={StaticResource StringToVisibilityConverter}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding ThumbnailUrl, Converter={StaticResource PosterImageConverter}, ConverterParameter=wide}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding Description}" Foreground="#B8FFFFFF" FontSize="9" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
            </StackPanel>

            <!-- Main column (web .streams-main): filters, status, stream list. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter chips (web .stream-filters): horizontal scroll row,
                     rebuilt in code-behind so focus can be restored by chip key. -->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="FiltersPanel" Orientation="Horizontal" Spacing="6" Padding="4,4,4,8"/>
                </ScrollViewer>

                <!-- Status line (web .streams-status): loading / hidden-torrent /
                     failed-addon lines, rebuilt in code-behind. -->
                <ItemsControl x:Name="StatusItems" Grid.Row="1" Padding="4,0,4,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                                <ProgressRing IsActive="{Binding ShowSpinner}" Width="8" Height="8" Foreground="White" VerticalAlignment="Center" Visibility="{Binding ShowSpinner, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Text}" Foreground="#FFFFB3B5" FontSize="8" TextWrapping="Wrap" Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Text}" Foreground="#80FFFFFF" FontSize="8" TextWrapping="Wrap" Visibility="{Binding IsError, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Stream list (web .stream-list) + loading / empty states. -->
                <Grid Grid.Row="2">
                    <ListView x:Name="StreamsListView" ItemTemplate="{StaticResource StreamItemTemplate}" ItemContainerStyle="{StaticResource StreamsListViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="StreamsListView_ItemClick" Padding="4,4,4,32" ScrollViewer.VerticalScrollBarVisibility="Hidden" Visibility="{Binding HasVisibleEntries, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid Visibility="{Binding ShowEmptyLoading, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="324">
                        <ProgressRing IsActive="True" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="324">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EmptyMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="ManageAddonsButton" x:Uid="ManageAddonsButton" Content="Manage Addons" Style="{StaticResource StreamsPrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="ManageAddonsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</views:FocusablePage>
