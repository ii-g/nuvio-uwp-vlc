<!-- Catalog page (Milestone 2): "View All" — one catalog as a grid, genre
     filters, infinite scroll. Ported from views/catalog.js.
     XYFocus keyboard navigation is off on purpose: the controller poll owns
     every move (see MainPage.OnPreviewKeyDown). Left on, the framework moves
     focus a second card per D-pad press on top of the router's move. -->
<Page
    x:Class="Nuvio.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Nuvio.Views"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <Page.Resources>
        <views:ChipSelectedBackgroundConverter x:Key="ChipSelectedBackgroundConverter"/>
        <views:ChipSelectedBorderConverter x:Key="ChipSelectedBorderConverter"/>
        <views:ChipSelectedForegroundConverter x:Key="ChipSelectedForegroundConverter"/>
    </Page.Resources>

    <Grid x:Name="RootGrid" XYFocusKeyboardNavigation="Disabled" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=content}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title (web .page-title: 2.6rem = 21 epx). Top margin tightened
             from the web's 3rem = 24 epx to 14 epx so the grid below gets
             more height and a 4th row peeks in.
             Start edge: the rowHeader inset (88 epx RTL / 6 epx LTR inside the
             content edge), the same edge as the home hero text, row titles and
             first cards (x=804 RTL / x=74 LTR) — not the content padding edge
             (x=892 RTL), which left the title 88 epx adrift of the rows. -->
        <Grid Grid.Row="0" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHeader}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="Bold"/>
                <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Genre filter chips: a horizontally scrolling strip (web catalog),
             start-aligned with the title. The plain horizontal StackPanel
             overflowed the 860 epx content width with no scroller, so the
             first ("كل") chip was cut at the start edge. The scrollbar stays
             hidden; a focused chip scrolls into view on focus change. -->
        <ScrollViewer Grid.Row="1" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHeader}" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Genres}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Web .chip: height 2.7rem = 22 epx, radius 1.35rem = 11 epx,
                         surface bg + 1 epx border token, text-2, SemiBold, gap .8rem = 6 epx;
                         selected = surface-3 bg, white text, transparent border. -->
                    <Button Content="{Binding DisplayName}" Click="GenreChip_Click" Background="{Binding IsSelected, Converter={StaticResource ChipSelectedBackgroundConverter}}" BorderBrush="{Binding IsSelected, Converter={StaticResource ChipSelectedBorderConverter}}" BorderThickness="1" Foreground="{Binding IsSelected, Converter={StaticResource ChipSelectedForegroundConverter}}" FontWeight="SemiBold" Padding="10,4" CornerRadius="11" FontSize="8" MinHeight="22" Margin="0,0,6,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <!-- Poster grid. Start edge: the rowHeader inset, so the first column's
             art rests on the same edge as the title and the chips (x=804 RTL /
             x=74 LTR). The grid runs to the bottom screen edge (Margin bottom
             0, top tightened to 10): there is no container edge below the last
             row and the viewport is ~461 epx tall, so about 3.9 rows of the
             70x105 cards are visible. MaximumRowsOrColumns=10: the viewport is
             772 epx wide (RTL) / 854 (LTR), and 10 columns need 10x77-7=763.
             Without the cap the LTR viewport would fit 11 columns (11x77-7=
             840) while RTL fits 10, so the cap keeps both directions at 10
             columns with no cut-off last column. -->
        <GridView x:Name="CatalogGridView" Grid.Row="2" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CatalogPosterCardTemplate}" ItemContainerStyle="{StaticResource CatalogGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="CatalogGridView_ItemClick" Visibility="{Binding IsEmptyState, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHeader}" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.BringIntoViewOnFocusChange="False">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!-- Empty state (unavailable / no titles / load failed) -->
        <Grid Grid.Row="2" Visibility="{Binding IsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="240">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding EmptyMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer spinner (web .grid-footer padding 1rem = 8 epx). -->
        <ProgressRing Grid.Row="3" IsActive="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,8"/>
    </Grid>
</Page>
