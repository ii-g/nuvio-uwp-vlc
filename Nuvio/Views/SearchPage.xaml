<!-- Search page (Milestone 2): native TextBox + one row per searchCatalogs(),
     recent searches. Ported from views/search.js.
     XYFocus keyboard navigation is off on purpose: the controller poll owns
     every move (see MainPage.OnPreviewKeyDown). Left on, the framework moves
     focus a second card per D-pad press on top of the router's move. -->
<Page
    x:Class="Nuvio.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <Grid x:Name="RootGrid" XYFocusKeyboardNavigation="Disabled">
        <!-- Dynamic background (Apple TV style): the focused result's poster art,
             decoded at 48x72 and box-blurred, cross-faded between two layers under
             a dark gradient so the text stays readable. The layer is empty (both
             images at opacity 0, dim at 0) while the empty hero shows, so the page
             keeps its dark background. IsHitTestVisible is off: the layer must never
             intercept input. -->
        <Grid IsHitTestVisible="False">
            <Image x:Name="BackgroundImageA" Stretch="UniformToFill" Opacity="0"/>
            <Image x:Name="BackgroundImageB" Stretch="UniformToFill" Opacity="0"/>
            <Border x:Name="BackgroundDim" Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#99000000"/>
                        <GradientStop Offset="1" Color="#D9000000"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="False">
            <StackPanel x:Name="ContentStack" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=content}">
                <!-- Search field, Apple TV style (no on-screen keyboard row): a large
                     borderless field, magnifier at the flow-start edge and large text
                     on the page background, no pill and no border, with a thin divider
                     under it like the Apple TV search screen. The placeholder is
                     bilingual: the Arabic translation is the TextBox's own placeholder
                     (so typed text lands exactly where the placeholder sat) and the
                     English original sits below it in smaller muted text; both hide
                     when the box has text. The field has no focus ring at all (no blue
                     accent border): focus is the caret and the placeholder/text
                     brightness, and the Xbox system keyboard still opens on focus.
                     Tapping anywhere in the field (magnifier, English line) focuses
                     the box. -->
                <Grid Margin="0,24,0,0" Tapped="SearchField_Tapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" x:Uid="SearchBox" Grid.Column="2" PlaceholderText="أفلام، مسلسلات، ممثلون، والمزيد" PlaceholderForeground="#80FFFFFF" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="White" Height="30" Padding="0" VerticalAlignment="Center" IsSpellCheckEnabled="False" UseSystemFocusVisuals="False">
                        <TextBox.Resources>
                            <!-- Borderless field: the box stays transparent in every state
                                 (no pill background, no template border, no focus wash) so
                                 the field reads as large text on the page background like
                                 Apple TV; the caret and the placeholder/text brightness are
                                 the only focus indication. -->
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlForeground" Color="White"/>
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80FFFFFF"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80FFFFFF"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80FFFFFF"/>
                        </TextBox.Resources>
                        <TextBox.InputScope>
                            <InputScope>
                                <InputScope.Names>
                                    <InputScopeName NameValue="Search"/>
                                </InputScope.Names>
                            </InputScope>
                        </TextBox.InputScope>
                    </TextBox>
                    <TextBlock x:Uid="SearchPlaceholderEnglish" Grid.Row="1" Grid.Column="2" Text="Movies, Shows, Cast, and More" FontSize="11" Foreground="#59FFFFFF" Margin="0,2,0,0" IsHitTestVisible="False" Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource InverseStringToVisibilityConverter}}"/>
                </Grid>
                <Border Height="1" Background="#1FFFFFFF" Margin="0,12,0,0"/>

                <!-- Empty state: a centred hero shown while no query is active and no
                     results exist (ViewModel.IsEmptyHero — first entry, or the query
                     cleared). The page cross-fades it against the results below. The
                     magnifier sits in a white circle with a soft white halo (outer
                     ring at 8% white, inner at 20%) on the dark theme — build 241:
                     the old blue accent circle is gone, only white/transparency
                     here; the title and the muted line sit under it, and the recent
                     searches live under the hero as part of the empty state — a chip
                     runs its query, as before. -->
                <Grid x:Name="EmptyHero" MinHeight="400">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                            <Ellipse Width="76" Height="76" Fill="#14FFFFFF"/>
                            <Ellipse Width="56" Height="56" Fill="#33FFFFFF"/>
                            <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Uid="SearchEmptyTitle" Text="Search" FontSize="17" FontWeight="Bold" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="SearchEmptySubtitle" Text="Search for movies and series" FontSize="9" Foreground="#80FFFFFF" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <!-- Recent searches -->
                        <StackPanel Visibility="{Binding IsRecentVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Uid="RecentSearchesTitle" Text="Recent Searches" FontSize="12" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding RecentSearches}" Margin="0,7,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Web .chip: height 2.7rem = 22 epx, radius 1.35rem = 11 epx,
                                             surface bg + 1 epx border token, text-2, SemiBold, gap .8rem = 6 epx. -->
                                        <Button Content="{Binding}" Click="RecentChip_Click" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Foreground="#B8FFFFFF" FontWeight="SemiBold" Padding="10,4" CornerRadius="11" FontSize="8" MinHeight="22" Margin="0,0,6,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Results (rows + loading + no-providers + no-results): hidden while the
                     empty hero shows; the page cross-fades the two. -->
                <Grid x:Name="ResultsContainer">
                <StackPanel>
                <!-- One row per search catalog -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,13">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="8" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                    <ProgressRing IsActive="{Binding IsLoading}" Width="8" Height="8" Foreground="White"/>
                                </StackPanel>
                                <GridView ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterCardTemplate}" ItemContainerStyle="{StaticResource CardGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="SearchRowGridView_ItemClick" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=row}" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowBleed}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading -->
                <ProgressRing IsActive="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" Margin="0,24,0,24"/>

                <!-- No search providers -->
                <Grid Visibility="{Binding IsNoProviders, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="240">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                        <TextBlock x:Uid="SearchNoProvidersTitle" Text="No search providers" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Uid="SearchNoProvidersMessage" Text="None of your addons supports search. Cinemeta (installed by default) does." FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- No results -->
                <Grid Visibility="{Binding IsNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="240">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                        <TextBlock x:Uid="SearchNoResultsTitle" Text="No results" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NoResultsMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
