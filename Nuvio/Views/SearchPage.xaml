<!-- Search page (Milestone 2): native TextBox + one row per searchCatalogs(),
     recent searches. Ported from views/search.js.
     XYFocus keyboard navigation is off on purpose: the controller poll owns
     every move (see MainPage.OnPreviewKeyDown). Left on, the framework moves
     focus a second card per D-pad press on top of the router's move. -->
<Page
    x:Class="Nuvio.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <Grid x:Name="RootGrid" XYFocusKeyboardNavigation="Disabled">
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="False">
            <StackPanel x:Name="ContentStack" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=content}">
                <!-- Search bar (web .search-bar): pill, surface-2 bg, hairline border,
                     muted icon + placeholder; height 4.4rem = 35 epx, radius 2.2rem = 18 epx.
                     The 8 epx icon/text gap is a fixed Grid column so it stays on the
                     flow-start side in RTL: a physical Margin on the icon landed on the
                     wrong side and pinned the icon flush to the bar's start edge, while
                     the Border's symmetric 13 epx padding (1.6rem) covers both ends.
                     Focus = accent border (see SearchBox GotFocus/LostFocus in the
                     code-behind); system focus visuals are off so the accent border is
                     the single ring. -->
                <Border x:Name="SearchBarBorder" Margin="0,24,0,0" Background="#1AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="18" Padding="13,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" x:Uid="SearchBox" Grid.Column="2" PlaceholderText="Search movies &amp; series" PlaceholderForeground="#80FFFFFF" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="White" Height="35" Padding="0" VerticalAlignment="Center" IsSpellCheckEnabled="False" UseSystemFocusVisuals="False">
                            <TextBox.Resources>
                                <!-- The default TextBox template inverts to a white background on
                                     focus (TextControlBackgroundFocused) with an accent border:
                                     on the dark theme that reads as a blinding white pill with a
                                     blue ring (build 216). The pill's own focus ring is the outer
                                     Border's accent border (GotFocus/LostFocus in the code-behind),
                                     so the box itself stays dark in every state: surface-2 like
                                     the bar, no template border, white text, muted placeholder. -->
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1AFFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1AFFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlForeground" Color="White"/>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80FFFFFF"/>
                            </TextBox.Resources>
                            <TextBox.InputScope>
                                <InputScope>
                                    <InputScope.Names>
                                        <InputScopeName NameValue="Search"/>
                                    </InputScope.Names>
                                </InputScope>
                            </TextBox.InputScope>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Empty state: a centred hero shown while no query is active and no
                     results exist (ViewModel.IsEmptyHero — first entry, or the query
                     cleared). The page cross-fades it against the results below. The
                     magnifier sits in an accent circle with a soft accent halo (outer
                     ring at 8% accent, inner at 20%); the title and the muted line sit
                     under it, and the recent searches live under the hero as part of the
                     empty state — a chip runs its query, as before. -->
                <Grid x:Name="EmptyHero" MinHeight="400">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <Grid Width="76" Height="76" HorizontalAlignment="Center">
                            <Ellipse Width="76" Height="76" Fill="#142F6FED"/>
                            <Ellipse Width="56" Height="56" Fill="#332F6FED"/>
                            <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="#FF3C7BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Uid="SearchEmptyTitle" Text="Search" FontSize="17" FontWeight="Bold" Foreground="White" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock x:Uid="SearchEmptySubtitle" Text="Search for movies and series" FontSize="9" Foreground="#80FFFFFF" TextAlignment="Center" HorizontalAlignment="Center"/>
                        <!-- Recent searches -->
                        <StackPanel Visibility="{Binding IsRecentVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Uid="RecentSearchesTitle" Text="Recent Searches" FontSize="12" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding RecentSearches}" Margin="0,7,0,0" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Web .chip: height 2.7rem = 22 epx, radius 1.35rem = 11 epx,
                                             surface bg + 1 epx border token, text-2, SemiBold, gap .8rem = 6 epx. -->
                                        <Button Content="{Binding}" Click="RecentChip_Click" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Foreground="#B8FFFFFF" FontWeight="SemiBold" Padding="10,4" CornerRadius="11" FontSize="8" MinHeight="22" Margin="0,0,6,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Results (rows + loading + no-providers + no-results): hidden while the
                     empty hero shows; the page cross-fades the two. -->
                <Grid x:Name="ResultsContainer">
                <StackPanel>
                <!-- One row per search catalog -->
                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,13">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="8" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                    <ProgressRing IsActive="{Binding IsLoading}" Width="8" Height="8" Foreground="White"/>
                                </StackPanel>
                                <GridView ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PosterCardTemplate}" ItemContainerStyle="{StaticResource CardGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="SearchRowGridView_ItemClick" Padding="6,9,6,12" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading -->
                <ProgressRing IsActive="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" Margin="0,24,0,24"/>

                <!-- No search providers -->
                <Grid Visibility="{Binding IsNoProviders, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="240">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                        <TextBlock x:Uid="SearchNoProvidersTitle" Text="No search providers" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Uid="SearchNoProvidersMessage" Text="None of your addons supports search. Cinemeta (installed by default) does." FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- No results -->
                <Grid Visibility="{Binding IsNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="240">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                        <TextBlock x:Uid="SearchNoResultsTitle" Text="No results" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NoResultsMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
