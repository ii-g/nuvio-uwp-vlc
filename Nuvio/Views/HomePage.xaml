<!-- XYFocus keyboard navigation is off on purpose: the controller poll owns
     every move (see MainPage.OnPreviewKeyDown). Left on, the framework moves
     focus a second card per D-pad press on top of the router's move. -->
<Page
    x:Class="Nuvio.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="using:Nuvio.Views.Shared"
    mc:Ignorable="d"
    XYFocusKeyboardNavigation="Disabled"
    Background="Transparent">

    <Page.Resources>
        <!-- Shared focus frame gradient (Fluent 2 Design card frame, recolored):
             light whites on glass: white to pale icy blue, 70% alpha so the
             frosted blur band under it shows through. The 0.5 stop is the
             contrast stop: it is what reads on a white poster. -->
        <LinearGradientBrush x:Key="FocusFrameGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#B3FFFFFF"/>
            <GradientStop Offset="0.25" Color="#B3E8F2FF"/>
            <GradientStop Offset="0.5" Color="#B3B4D8FF"/>
            <GradientStop Offset="0.75" Color="#B3E8F2FF"/>
            <GradientStop Offset="1" Color="#B3FFFFFF"/>
        </LinearGradientBrush>
        <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#A62F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- Frosted glass: the same backdrop blur the sidebar uses
                                 (SidebarBackdropBlurBrush, GaussianBlur 20, no tint) -->
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <!-- Translucent tint over the blur: the style's Background. -->
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <!-- Focus frame (Fluent 2 Design card frame, recolored to
                                 light whites on glass): frosted blur band + light
                                 gradient border + 2 epx #FAFAFA inner ring. The only
                                 focus indicator: the old white pill (TintBorder to
                                 White, text to Black) is gone. All Opacity 0 until
                                 Focused/PointerFocused. -->
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" BorderBrush="{StaticResource FocusFrameGradientBrush}" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="FocusInnerRing" BorderThickness="2" BorderBrush="#FAFAFA" CornerRadius="11" Margin="2" Opacity="0" IsHitTestVisible="False"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#CC3C7BFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusInnerRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusInnerRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeroActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- Frosted glass: the same backdrop blur the sidebar uses
                                 (SidebarBackdropBlurBrush, GaussianBlur 20, no tint) -->
                            <Border x:Name="GlassBorder" CornerRadius="{TemplateBinding CornerRadius}">
                                <Border.Background>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.Background>
                            </Border>
                            <!-- Translucent tint over the blur: the style's Background. -->
                            <Border x:Name="TintBorder" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"/>
                            <TextBlock x:Name="ContentText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" shared:TextGlow.IsEnabled="True"/>
                            <!-- Focus frame (Fluent 2 Design card frame, recolored to
                                 light whites on glass): frosted blur band + light
                                 gradient border + 2 epx #FAFAFA inner ring. The only
                                 focus indicator: the old white pill (TintBorder to
                                 White, text to Black) is gone. All Opacity 0 until
                                 Focused/PointerFocused. -->
                            <Border x:Name="FocusGlassBand" BorderThickness="3" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <shared:SidebarBackdropBlurBrush/>
                                </Border.BorderBrush>
                            </Border>
                            <Border x:Name="FocusRing" BorderThickness="3" BorderBrush="{StaticResource FocusFrameGradientBrush}" CornerRadius="{TemplateBinding CornerRadius}" Margin="-1" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="FocusInnerRing" BorderThickness="2" BorderBrush="#FAFAFA" CornerRadius="11" Margin="2" Opacity="0" IsHitTestVisible="False"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TintBorder" Storyboard.TargetProperty="Background"><DiscreteObjectKeyFrame KeyTime="0" Value="#4DFFFFFF"/></ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusInnerRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused">
                                        <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusGlassBand" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="FocusInnerRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" XYFocusKeyboardNavigation="Disabled">
        <!-- Backdrop: two cross-fading layers following the focused card.
             A light bottom gradient (option B) so the rows read on light
             fanart — no blur on the backdrop at all. -->
        <Grid x:Name="BackdropHost" IsHitTestVisible="False">
            <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0"/>
            <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0"/>
            <!-- Light bottom shade (option B): a static vertical gradient —
                 fully transparent to 0.45, grading to ~40% black at the
                 bottom — so the rows read on light fanart while the
                 backdrop stays visible. No flat shade, no full-screen
                 coverage. -->
            <Rectangle x:Name="BackdropShadeRect">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="0.45" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#66000000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" BringIntoViewOnFocusChange="False">
            <StackPanel x:Name="ContentStack" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=content}">
                <!-- Hero carousel -->
                <Grid x:Name="HeroSection" Visibility="{Binding HasHero, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="272" Height="356">
                    <StackPanel x:Name="HeroContent" VerticalAlignment="Bottom" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=hero}" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}}" MaxWidth="352">
                        <Image x:Name="HeroLogo" Source="{Binding CurrentHero.Logo, Converter={StaticResource PosterImageConverter}, ConverterParameter=logo}" Stretch="Uniform" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}}" MaxWidth="240" MaxHeight="80" Visibility="{Binding CurrentHero.Logo, Converter={StaticResource StringToVisibilityConverter}}" shared:TextGlow.IsEnabled="True"/>
                        <!-- Text glow: soft omnidirectional halo via shared:TextGlow
                             (Composition DropShadow, blur 3, black 90%) so white text
                             reads on light fanart. -->
                        <Grid Visibility="{Binding CurrentHero.Logo, Converter={StaticResource InverseStringToVisibilityConverter}}">
                            <TextBlock x:Name="HeroTitle" Text="{Binding CurrentHero.Name}" FontSize="27" FontWeight="ExtraBold" LineHeight="28" TextWrapping="Wrap" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,9,0,0">
                            <Grid>
                                <TextBlock Text="{Binding HeroYear}" FontSize="9" Foreground="#B8FFFFFF" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{Binding HeroRating}" FontSize="9" Foreground="White" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="{Binding HeroType}" FontSize="9" Foreground="#B8FFFFFF" shared:TextGlow.IsEnabled="True"/>
                            </Grid>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding HeroGenres}" Margin="0,9,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1FFFFFFF" CornerRadius="8" Padding="6,1">
                                        <Grid>
                                            <TextBlock Text="{Binding}" FontSize="8" shared:TextGlow.IsEnabled="True"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,9,0,0">
                            <TextBlock x:Name="HeroDescription" Text="{Binding HeroDescription}" FontSize="9" Foreground="#B8FFFFFF" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" TextAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToTextAlignmentConverter}}" shared:TextGlow.IsEnabled="True"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,13,0,0">
                            <Button x:Name="HeroPlayButton" Content="{Binding HeroPlayLabel}" Style="{StaticResource HeroPrimaryButtonStyle}" Click="HeroPlayButton_Click"/>
                            <Button x:Name="HeroDetailsButton" x:Uid="HeroDetailsButton" Content="Details" Style="{StaticResource HeroActionButtonStyle}" Click="HeroDetailsButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToHorizontalAlignmentConverter}, ConverterParameter=invert}" VerticalAlignment="Bottom" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" Spacing="4" FlowDirection="LeftToRight" VerticalAlignment="Center">
                            <Border x:Name="LbChip" Background="#1FFFFFFF" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="LB" FontSize="7" FontWeight="SemiBold" Foreground="#B8FFFFFF"/>
                            </Border>
                            <StackPanel x:Name="HeroDots" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"/>
                            <Border x:Name="RbChip" Background="#1FFFFFFF" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                <TextBlock Text="RB" FontSize="7" FontWeight="SemiBold" Foreground="#B8FFFFFF"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Continue Watching -->
                <StackPanel x:Name="ContinueSection" Visibility="{Binding HasContinueItems, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,13">
                    <Grid Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHeader}">
                        <TextBlock x:Uid="ContinueWatchingTitle" Text="Continue Watching" FontSize="12" FontWeight="Bold" shared:TextGlow.IsEnabled="True"/>
                    </Grid>
                    <GridView x:Name="ContinueGridView" ItemsSource="{Binding ContinueItems}" ItemTemplate="{StaticResource ContinueCardTemplate}" ItemContainerStyle="{StaticResource CardGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="ContinueGridView_ItemClick" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHome}" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowBleed}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>

                <!-- One row per catalog -->
                <ItemsControl ItemsSource="{Binding CatalogRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,13">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHeader}">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" shared:TextGlow.IsEnabled="True"/>
                                    </Grid>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Subtitle}" FontSize="8" Foreground="#80FFFFFF" VerticalAlignment="Center" shared:TextGlow.IsEnabled="True"/>
                                    </Grid>
                                    <ProgressRing IsActive="{Binding IsLoading}" Width="8" Height="8" Foreground="White"/>
                                </StackPanel>
                                <GridView ItemsSource="{Binding Items}" ItemTemplateSelector="{StaticResource CatalogCardSelector}" ItemContainerStyle="{StaticResource CardGridViewItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="CatalogRowGridView_ItemClick" Padding="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowHome}" Margin="{Binding FlowDirection, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FlowDirectionToThicknessConverter}, ConverterParameter=rowBleed}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.BringIntoViewOnFocusChange="False">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading -->
                <ProgressRing IsActive="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" Margin="0,24,0,24"/>

                <!-- Empty state -->
                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" MinHeight="432">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="384">
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EmptyMessage}" FontSize="9" Foreground="#B8FFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="ManageAddonsButton" x:Uid="ManageAddonsButton" Content="Manage Addons" Style="{StaticResource HeroPrimaryButtonStyle}" HorizontalAlignment="Center" Click="ManageAddonsButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
