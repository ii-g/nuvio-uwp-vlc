  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  <!-- Declared after the import above so it overrides the VC++ runtime references added by the NuGet
       packages. VideoLAN.LibVLC.UWP still references the VC++ 2013 runtime, but its libvlc DLLs link
       vcruntime140_app.dll. libvlc and WebView2's Core DLL need the retail runtimes in every
       configuration, because the debug runtimes only ship the *d.dll variants. -->
  <ItemGroup>
    <SDKReference Remove="Microsoft.VCLibs.120, Version=14.0;Microsoft.VCLibs, Version=14.0;Microsoft.VCLibs.Desktop, Version=14.0" />
    <SDKReference Include="Microsoft.VCLibs, Version=14.0;Microsoft.VCLibs.Desktop, Version=14.0">
      <TargetedSDKConfiguration>Retail</TargetedSDKConfiguration>
    </SDKReference>
  </ItemGroup>
  <!-- The package's file list (the .appxrecipe) is only rewritten when MSBuild thinks it's out of
       date, which misses web files added since the last full build: the app then ships without
       them and the web app can't start. Rewrite it on every build. -->
  <ItemGroup>
    <None Include="Nuvio_TemporaryKey.pfx" />
  </ItemGroup>
  <Target Name="RefreshPackageFileList" BeforeTargets="BeforeBuild">
    <Delete Files="$(OutDir)$(TargetName).build.appxrecipe" ContinueOnError="true" />
  </Target>
